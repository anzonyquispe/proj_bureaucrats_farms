. estimates store eq4

. 
. *****************************************************************************
> ***
. * Save estimates to ster file
. *****************************************************************************
> ***
. 
. estwrite eq1 eq2 eq3 eq4 using "${table_farms}/main_did_downup_area_ac${sampl
> e}_rural_acpop.ster", replace
(saving eq1)
(saving eq2)
(saving eq3)
(saving eq4)
(file /groups/sgulzar/sa_fires/proj_bureaucrats_farms/tex/paper/tables/main_did
> _downup_area_ac_rural_acpop.ster saved)

. 
. display "Estimates saved to: ${table_farms}/main_did_downup_area_ac${sample}_
> rural_acpop.ster"
Estimates saved to: /groups/sgulzar/sa_fires/proj_bureaucrats_farms/tex/paper/t
> ables/main_did_downup_area_ac_rural_acpop.ster

. 
