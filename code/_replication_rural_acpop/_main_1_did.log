        e(monthyearfe) : "N"

. estadd local acfe "N"

added macro:
               e(acfe) : "N"

. estadd local acmonthfe "Y"

added macro:
          e(acmonthfe) : "Y"

. estadd local gridfe "N"

added macro:
             e(gridfe) : "N"

. estimates store eq3

. 
