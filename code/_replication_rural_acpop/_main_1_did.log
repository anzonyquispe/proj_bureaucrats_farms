. estadd local ymean `meandv_fmt'

added macro:
              e(ymean) : "170.747"

. estadd local acq `numacs'

added macro:
                e(acq) : "808"

. estadd local monthyearfe "Y"

added macro:
        e(monthyearfe) : "Y"

. estadd local acfe "Y"

added macro:
               e(acfe) : "Y"

. estadd local acmonthfe "N"

added macro:
          e(acmonthfe) : "N"

. estadd local gridfe "N"

added macro:
             e(gridfe) : "N"

. estimates store eq2

. 
. * Specification 3: AC x MonthYear FE
. reghdfejl countk downup_ac_pop $controls, ///
>     absorb(ac_id#monthyear) ///
>     cluster(grid_id cluster_acmonth)
