. do _app_9_main_did_by_state.do 

. *****************************************************************************
> ***
. * _app_main_did_by_state_rural.do
. * Replicates _app_main_did_by_state.R - RURAL GRIDS ONLY
. * DiD regressions by state/province
. *****************************************************************************
> ***
. 
. *****************************************************************************
> ***
. * Setup - Only set globals if running standalone (not from master)
. *****************************************************************************
> ***
. 
. if "$root" == "" {
.     clear all
.     set more off
. 
.     global location "shell"
.     global sample ""
. 
.     global shell "/groups/sgulzar/sa_fires/proj_bureaucrats_farms"
.     global dbox "/Users/anzony.quisperojas/Library/CloudStorage/Dropbox/sa_fi
> res/proj_bureaucrats_farms"
. 
.     if "$location" == "dbox" {
.         global root "$dbox"
.     }
.     else {
.         global root "$shell"
.     }
. }

. 
. cd "${root}"
/groups/sgulzar/sa_fires/proj_bureaucrats_farms

. 
. *****************************************************************************
> ***
. * Import Data
. *****************************************************************************
> ***
. 
. import delimited "${root}/data_output/intermediate/0_master_merge_data_gen${s
> ample}.csv", clear
(encoding automatically selected: ISO-8859-2)
(77 vars, 14,837,592 obs)

. 
. * Merge with rural classification
. merge m:1 unique_small_grid_id using "${root}/data_output/intermediate/ghs_gr
> id_classification_2000.dta", keepusing(is_rural)

    Result                      Number of obs
    -----------------------------------------
    Not matched                        58,521
        from master                         0  (_merge==1)
        from using                     58,521  (_merge==2)

    Matched                        14,837,592  (_merge==3)
    -----------------------------------------

. keep if _merge == 3
(58,521 observations deleted)

. drop _merge

. 
. * Keep only rural grids
. keep if is_rural == 1
(3,471,192 observations deleted)

. 
. display "Observations after rural filter: " _N
Observations after rural filter: 11366400

. 
. * Drop grids with more than 1 ac
. merge m:1 unique_small_grid_id using "${root}/data_output/intermediate/grids_
> with_more_1_ac.dta"

    Result                      Number of obs
    -----------------------------------------
    Not matched                    11,356,812
        from master                11,356,780  (_merge==1)
        from using                         32  (_merge==2)

    Matched                             9,620  (_merge==3)
    -----------------------------------------

. drop if dpl_ac ==1
(9,652 observations deleted)

. drop _merge

. 
. * Create count in thousands
. gen countk = count * 1000

. 
. * Filter data: year < 2022 or (year == 2022 & month <= 8)
. keep if year < 2022 | (year == 2022 & month <= 8)
(2,148,580 observations deleted)

. 
. * Sort data
. sort unique_small_grid_id monthyear

. 
. *****************************************************************************
> ***
. * Encode IDs
. *****************************************************************************
> ***
. 
. capture confirm numeric variable unique_small_grid_id

. if _rc {
.     encode unique_small_grid_id, gen(grid_id)
. }

. else {
.     gen grid_id = unique_small_grid_id
. }

. 
. capture confirm numeric variable ac_uq_id

. if _rc {
.     encode ac_uq_id, gen(ac_id)
. }

. else {
.     gen ac_id = ac_uq_id
. }

. 
. * Create cluster variable
. egen cluster_acmonth = group(ac_id monthyear)

. bys unique_small_grid_id: egen treat_wind = max(downup_ac_pop)

. 
. *****************************************************************************
> ***
. * Get list of states (using numeric encoding to handle spaces)
. *****************************************************************************
> ***
. 
. * Encode province to handle names with spaces (like "Uttar Pradesh")
. encode province, gen(province_id)

. label list province_id
province_id:
           1 Bihar
           2 Haryana
           3 Punjab_IND
           4 Uttar Pradesh

. 
. * Get number of states
. summarize province_id

    Variable |        Obs        Mean    Std. dev.       Min        Max
-------------+---------------------------------------------------------
 province_id |  9,208,200    3.108712     1.17773          1          4

. local nstates = r(max)

. display "Number of states: `nstates'"
Number of states: 4

. 
. *****************************************************************************
> ***
. * Run Regressions by State
. *****************************************************************************
> ***
. 
. global controls av_wind_speed wind_direction

. 
. local i = 1

. local state_labels ""

. 
. forvalues prov_num = 1/`nstates' {
  2. 
.     * Get province name from label
.     local st : label province_id `prov_num'
  3.     display "Running regression for: `st'"
  4. 
.     preserve
  5.     keep if province_id == `prov_num'
  6. 
.     * Count unique ACs for this state
.     unique ac_id
  7.     local numacs`i' = r(unique)
  8. 
.     * Calculate mean DV for this state
.     summarize countk if treat_wind == 1 & downup_ac_pop == 0
  9.     local meandv`i' = string(r(mean), "%9.3f")
 10. 
.     * Run regression
.     reghdfejl countk downup_ac_pop $controls, ///
>         absorb(grid_id ac_id#monthyear) cluster(grid_id cluster_acmonth)
 11. 
.     * Store statistics
.     estadd local gridfe "Y"
 12.     estadd local acmonthfe "Y"
 13.     estadd local ymean "`meandv`i''"
 14.     estadd local acq "`numacs`i''"
 15. 
.     est store eq`i'
 16. 
.     restore
 17. 
.     * Build state label (clean name for table)
.     local clean_st = subinstr("`st'", "_", " ", .)
 18.     local clean_st = subinstr("`clean_st'", "IND", "", .)
 19.     local state_labels `"`state_labels' "`clean_st'""'
 20. 
.     local i = `i' + 1
 21. }
