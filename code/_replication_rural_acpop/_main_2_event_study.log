. do _main_2_event_study.do 

. *----------------------------------------------------------------------------
> ---
. * Main Event Study - RURAL GRIDS ONLY
. * Output: main_event_study_rural_acpop.ster
. *----------------------------------------------------------------------------
> ---
. 
. *****************************************************************************
> ***
. * Setup - Only set globals if running standalone (not from master)
. *****************************************************************************
> ***
. 
. if "$root" == "" {
.     clear all
.     set more off
. 
.     * Set toggles for standalone run
.     global location "shell"
.     global sample ""
. 
.     * DATA roots
.     global shell "/groups/sgulzar/sa_fires/proj_bureaucrats_farms"
.     global dbox  "/Users/anzony.quisperojas/Library/CloudStorage/Dropbox/sa_f
> ires/proj_bureaucrats_farms"
. 
.     * CODE roots (code is NOT a subpath of data root on either machine)
.     global code_shell "/users/aquisper/proj_bureaucrats_farms/code/_replicati
> on_rural_acpop"
.     global code_dbox  "/Users/anzony.quisperojas/Documents/GitHub/proj_bureau
> crats_farms/code/_replication_rural_acpop"
. 
.     if "$location" == "dbox" {
.         global root "$dbox"
.         global code "$code_dbox"
.     }
.     else {
.         global root "$shell"
.         global code "$code_shell"
.     }
. 
.     * Load Ados
.     qui do "${code}/estsave_csv.ado"
. 
. }

. 
. 
. *----------------------------------------------------------------------------
> ---
. * Import and Merge Data
. *----------------------------------------------------------------------------
> ---
. 
. import delimited "${root}/data_output/intermediate/0_master_merge_data_gen${s
> ample}.csv", clear varnames(1)
(encoding automatically selected: ISO-8859-2)
(77 vars, 14,837,592 obs)

. 
. * Merge with rural classification
. merge m:1 unique_small_grid_id using "${root}/data_output/intermediate/ghs_gr
> id_classification_2000.dta", keepusing(is_rural)

    Result                      Number of obs
    -----------------------------------------
    Not matched                        58,521
        from master                         0  (_merge==1)
        from using                     58,521  (_merge==2)

    Matched                        14,837,592  (_merge==3)
    -----------------------------------------

. keep if _merge == 3
(58,521 observations deleted)

. drop _merge

. 
. * Keep only rural grids
. keep if is_rural == 1
(3,471,192 observations deleted)

. 
. display "Observations after rural filter: " _N
Observations after rural filter: 11366400

. 
. * Drop grids with more than 1 ac
. merge m:1 unique_small_grid_id using "${root}/data_output/intermediate/grids_
> with_more_1_ac.dta"

    Result                      Number of obs
    -----------------------------------------
    Not matched                    11,356,812
        from master                11,356,780  (_merge==1)
        from using                         32  (_merge==2)

    Matched                             9,620  (_merge==3)
    -----------------------------------------

. drop if dpl_ac ==1
(9,652 observations deleted)

. drop _merge

. 
. * Keep relevant time period
. keep if year < 2022 | (year == 2022 & month <= 8)
(2,148,580 observations deleted)

. keep unique_small_grid_id monthyear downup_ac_pop av_wind_speed wind_directio
> n count ac_uq_id is_rural rice_area_aclvl_ahigh rice_harvarea_aclvl_ahigh ric
> e_prod_aclvl_ahigh

. 
. *----------------------------------------------------------------------------
> ---
. * Generate Event Study Variables
. *----------------------------------------------------------------------------
> ---
. 
. * Temporarily rename variables
. rename downup_ac_pop abs

. 
. * First, set switchtoexp = 1 everytime there is a switch
. gsort unique_small_grid_id monthyear

. bys unique_small_grid_id: gen switchtoexp=1 if abs==1 & abs[_n-1]==0
(8,462,707 missing values generated)

. 
. * Set switch to unexp = 1 if switch to unexposed
. gsort unique_small_grid_id monthyear

. bys unique_small_grid_id: gen switchtounexp=1 if abs==0 & abs[_n-1]==1
(8,461,385 missing values generated)

. 
. * Second, set rtime = +n after the switch and -n after
. gen rtime_abs=switchtoexp
(8,462,707 missing values generated)

. replace rtime_abs=-1 if switchtounexp==1
(746,815 real changes made)

.     bys unique_small_grid_id: replace rtime_abs=rtime_abs[_n-1]+1 if abs==1 &
>  rtime_abs==.
(3015970 real changes made)

. gsort unique_small_grid_id -monthyear

. replace rtime_abs=. if rtime_abs==-1
(746,815 real changes made, 746,815 to missing)

. replace rtime_abs=-1 if rtime_abs==. & rtime_abs[_n-1]==1
(745,493 real changes made)

.     bys unique_small_grid_id: replace rtime_abs=rtime_abs[_n-1]-1 if abs==0 &
>  rtime_abs==.
(2959850 real changes made)

. 
. drop switchtoexp switchtounexp

. gsort unique_small_grid_id monthyear

. 
. * Time invariant treatment
. bys unique_small_grid_id: egen TREAT_abs=max(abs)

. 
. * First treated time is zero
. replace rtime_abs=rtime_abs-1 if rtime_abs>0
(3,761,463 real changes made)

. 
. rename abs downup_ac_pop

. 
. * Generate event study dummies
. su rtime_abs

    Variable |        Obs        Mean    Std. dev.       Min        Max
-------------+---------------------------------------------------------
   rtime_abs |  7,466,806   -.1560671    10.86031       -119        118

. forvalues l = 0/6 {
  2.     gen byte La`l'_abs = rtime_abs ==`l'
  3.     label var La`l'_abs "`l'"
  4. }

. forvalues l = 1/6 {
  2.     gen byte Le`l'_abs = rtime_abs ==-`l'
  3.     label var Le`l'_abs "-`l'"
  4. }

. 
. drop La0_abs // normalize rtime = 0

. 
. gen countk = count * 1000

. 
. global tr abs

. 
. drop if TREAT_$tr==1 & rtime_$tr>=7
(1,938,877 observations deleted)

. drop if TREAT_$tr==1 & rtime_$tr<=-7
(995,008 observations deleted)

. bys unique_small_grid_id: egen TREAT = max(downup_ac_pop)

. 
. *----------------------------------------------------------------------------
> ---
. * Regressions
. *----------------------------------------------------------------------------
> ---
. 
. global controls av_wind_speed wind_direction

. global cluster unique_small_grid_id monthyear#ac_uq_id

. local dep_var countk

. 
. local fe1 "unique_small_grid_id ac_uq_id#monthyear"

. 
. * Compute mean of dep var where untreated
. quietly summarize `dep_var' if downup_ac_pop ==0 & TREAT == 1

. local ymean = r(mean)

. gen moderator = 0

. * Count number of unique ACs in subsample
. unique ac_uq_id
Number of unique values of ac_uq_id is  808
Number of records is  6274315

. local numacs = r(unique)

. local modlist moderator rice_area_aclvl_ahigh rice_harvarea_aclvl_ahigh rice_
> prod_aclvl_ahigh

. local i = 1

. foreach mod of local modlist{
  2.         
.         local rhs Le*_${tr} La*_${tr} 1.Le*_${tr}#1.`mod' 1.La*_${tr}#1.`mod'
>  $controls
  3.         
.         quietly summarize `dep_var' if downup_ac_pop ==0 & TREAT == 1 & `mod'
>  == 1
  4.         local ymean2 = cond(r(N) == 0, `ymean', r(mean))
  5.         
.         quietly summarize `dep_var' if downup_ac_pop ==0 & TREAT == 1 & `mod'
>  == 0
  6.         local ymean3 = cond(r(N) == 0, `ymean', r(mean))
  7.         
.         * Run regression with clustering
.         reghdfejl `dep_var' `rhs', absorb(`fe1') cluster($cluster) nocons
  8. 
.         * Store coefficient + SE of main var
.         estadd local ymean `ymean'
  9.         estadd local ymean2 `ymean2'
 10.         estadd local ymean3 `ymean3'
 11.         estadd local acq `numacs'
 12.         est store evreg`i'
 13.         local i = `i' + 1
 14. }
