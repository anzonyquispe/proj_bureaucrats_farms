. do _main_4_protest_5km_fe12_did_downup.do 

. *****************************************************************************
> ***
. * _main_4_protest_5km_fe12_did_downup_rural.do
. * Protest DiD analysis with downup_ac_pop moderator - RURAL GRIDS ONLY
. * 6 columns: 3 FE specs × 2 moderator types (baseline + downup_ac_pop)
. *****************************************************************************
> ***
. 
. *****************************************************************************
> ***
. * Setup - Only set globals if running standalone (not from master)
. *****************************************************************************
> ***
. 
. if "$root" == "" {
.     clear all
.     set more off
. 
.     * Set toggles for standalone run
.     global location "shell"
.     global sample ""
. 
.     global shell "/groups/sgulzar/sa_fires/proj_bureaucrats_farms"
.     global dbox "/Users/anzony.quisperojas/Library/CloudStorage/Dropbox/sa_fi
> res/proj_bureaucrats_farms"
. 
.     if "$location" == "dbox" {
.         global root "$dbox"
.     }
.     else {
.         global root "$shell"
.     }
. }

. 
. cd "${root}"
/groups/sgulzar/sa_fires/proj_bureaucrats_farms

. 
. *****************************************************************************
> ***
. * Import Data
. *****************************************************************************
> ***
. 
. import delimited using "${root}/data_output/intermediate/stacked_data_protest
> ${sample}.csv", clear varnames(1)
(encoding automatically selected: ISO-8859-9)
(31 vars, 189,881,483 obs)

. 
. * Merge with rice moderators
. merge m:1 unique_small_grid_id ac_uq_id using "data_output/intermediate/rice_
> moderators.dta"

    Result                      Number of obs
    -----------------------------------------
    Not matched                            98
        from master                         0  (_merge==1)
        from using                         98  (_merge==2)

    Matched                       189,881,483  (_merge==3)
    -----------------------------------------

. keep if _merge == 3
(98 observations deleted)

. drop _merge

. 
. * Merge with rural classification
. merge m:1 unique_small_grid_id using "${root}/data_output/intermediate/ghs_gr
> id_classification_2000.dta", keepusing(is_rural)

    Result                      Number of obs
    -----------------------------------------
    Not matched                        58,522
        from master                         0  (_merge==1)
        from using                     58,522  (_merge==2)

    Matched                       189,881,483  (_merge==3)
    -----------------------------------------

. keep if _merge == 3
(58,522 observations deleted)

. drop _merge

. 
. * Keep only rural grids
. keep if is_rural == 1
(41,710,453 observations deleted)

. 
. display "Observations after rural filter: " _N
Observations after rural filter: 1.482e+08

. 
. * Drop grids with more than 1 ac
. merge m:1 unique_small_grid_id using "${root}/data_output/intermediate/grids_
> with_more_1_ac.dta"

    Result                      Number of obs
    -----------------------------------------
    Not matched                   148,049,500
        from master               148,049,467  (_merge==1)
        from using                         33  (_merge==2)

    Matched                           121,563  (_merge==3)
    -----------------------------------------

. drop if dpl_ac ==1
(121,596 observations deleted)

. drop _merge

. 
. *----------------------------------------------------------------------------
> ---
. * Merge in downup_ac_pop from master data (not present in this dataset)
. *----------------------------------------------------------------------------
> ---
. preserve

. import delimited "${root}/data_output/intermediate/0_master_merge_data_gen${s
> ample}.csv", ///
>     clear varnames(1)
(encoding automatically selected: ISO-8859-2)
(77 vars, 14,837,592 obs)

. keep unique_small_grid_id monthyear downup_ac_pop

. duplicates drop unique_small_grid_id monthyear, force

Duplicates in terms of unique_small_grid_id monthyear

(0 observations are duplicates)

. tempfile downup_ac_pop_lookup

. save `downup_ac_pop_lookup'
file /tmp/934195.1.largemem/stata.934195/St314990.000002 saved as .dta format

. restore

. merge m:1 unique_small_grid_id monthyear using `downup_ac_pop_lookup', ///
>     keep(master match) keepusing(downup_ac_pop) nogen

    Result                      Number of obs
    -----------------------------------------
    Not matched                             0
    Matched                       148,049,467  
    -----------------------------------------

. 
. *****************************************************************************
> ***
. * Generate Variables
. *****************************************************************************
> ***
. 
. sum relative_year_bin

    Variable |        Obs        Mean    Std. dev.       Min        Max
-------------+---------------------------------------------------------
relative_y~n |148,049,467   -3.735022    2.741565         -8          1

. local rmin = r(min)

. gen post_ = relative_year_bin >= 0

. gen moderator = 0

. 
. local dep_var countk

. local rhs "ib0.post_##ib0.treat##ib0.moderator wind_direction av_wind_speed"

. 
. * FE specifications
. local fe1 "unique_small_grid_id_cohort relative_year_bin"

. local fe2 "unique_small_grid_id_cohort relative_year_bin province_cohort#elec
> tion_year"

. local fe3 "unique_small_grid_id_cohort relative_year_bin province_cohort#elec
> tion_year province_cohort#c.monthyear "

. 
. * Statistics
. quietly summarize `dep_var' if treat == 1 & relative_year_bin <= -1

. local ymean_fmt = string(r(mean), "%9.3f")

. unique ac_uq_id
Number of unique values of ac_uq_id is  808
Number of records is  148049467

. local numacs = r(unique)

. 
. *****************************************************************************
> ***
. * Run Regressions
. *****************************************************************************
> ***
. 
. local i = 1

. 
. foreach mod in 0 1 {
  2. 
.     if `mod' == 0 {
  3.         replace moderator = 0
  4.     }
  5.     else {
  6.         replace moderator = downup_ac_pop
  7.         replace moderator = . if downup_ac_pop == .
  8.     }
  9.         
.         quietly summarize `dep_var' if treat == 1 & relative_year_bin <= -1 &
>  moderator == 1
 10.         local ymean2 = r(mean)
 11. 
.         quietly summarize `dep_var' if treat == 1 & relative_year_bin <= -1 &
>  moderator == 0
 12.         local ymean3 = cond(r(N) == 0, " ", string(r(mean), "%9.3f"))
 13. 
. 
. 
.     foreach fe of numlist 1/3 {
 14. 
.         reghdfejl `dep_var' `rhs', absorb(`fe`fe'') cluster(ac_area_tr)
 15. 
.         * Store FE indicators
.         estadd local gridfe "Y"
 16.                 estadd local time "Y"
 17.                 estadd local electionfe = cond(`fe' >= 2, "Y", "N")
 18.         estadd local provtrendfe = cond(`fe' == 3, "Y", "N")
 19.         estadd local ymean "`ymean_fmt'"
 20.                 estadd scalar ymean2 `ymean2'
 21.                 estadd local ymean3 "`ymean3'"
 22.         estadd local acq "`numacs'"
 23. 
.         est store evreg`i'
 24.         local i = `i' + 1
 25.     }
 26. }
