. do _app_20_did_downwind_hm.do 

. *****************************************************************************
> ***
. * _main_did_rural.do
. * Replicates analysis from _main_did.R - RURAL GRIDS ONLY
. * Generates DiD table with downup_ac_pop treatment
. *****************************************************************************
> ***
. 
. *****************************************************************************
> ***
. * Setup - Only set globals if running standalone (not from master)
. *****************************************************************************
> ***
. clear all 

. macro drop _all

. 
. if "$root" == "" {
.     clear all
.     set more off
. 
.     * Set toggles for standalone run
.     global location "shell"
.     global sample ""
. 
.     global shell "/groups/sgulzar/sa_fires/proj_bureaucrats_farms"
.     global dbox "/Users/anzony.quisperojas/Library/CloudStorage/Dropbox/sa_fi
> res/proj_bureaucrats_farms"
. 
.     if "$location" == "dbox" {
.         global root "$dbox"
.     }
.     else {
.         global root "$shell"
.     }
. }

. 
. global int_farms "${root}/data_output/intermediate"

. global table_farms "${root}/tex/paper/tables"

. global figure_farms "${root}/tex/paper/figures"

. 
. *****************************************************************************
> ***
. * Import Data
. *****************************************************************************
> ***
. 
. import delimited "${int_farms}/0_master_merge_data_gen${sample}.csv", clear
(encoding automatically selected: ISO-8859-2)
(77 vars, 14,837,592 obs)

. 
. * Merge with rural classification
. merge m:1 unique_small_grid_id using "${root}/data_output/intermediate/ghs_gr
> id_classification_2000.dta", keepusing(is_rural)

    Result                      Number of obs
    -----------------------------------------
    Not matched                        58,521
        from master                         0  (_merge==1)
        from using                     58,521  (_merge==2)

    Matched                        14,837,592  (_merge==3)
    -----------------------------------------

. keep if _merge == 3
(58,521 observations deleted)

. drop _merge

. 
. * Keep only rural grids
. keep if is_rural == 1
(3,471,192 observations deleted)

. 
. display "Observations after rural filter: " _N
Observations after rural filter: 11366400

. 
. * Drop grids with more than 1 ac
. // merge m:1 unique_small_grid_id using "${root}/data_output/intermediate/gri
> ds_with_more_1_ac.dta"
. // drop if dpl_ac ==1
. // drop _merge
. 
. * Create count in thousands
. gen countk = count * 1000

. 
. * Filter data: year < 2022 or (year == 2022 & month <= 8)
. keep if year < 2022 | (year == 2022 & month <= 8)
(2,150,400 observations deleted)

. 
. * Sort data
. sort unique_small_grid_id monthyear

. gen hm = 1 if ((month == 10) | (month == 11))
(7,680,000 missing values generated)

. replace hm = 0 if hm == .
(7,680,000 real changes made)

. keep if hm == 1
(7,680,000 observations deleted)

. 
. *****************************************************************************
> ***
. * Create TREAT_abs variable (to identify pure control)
. *****************************************************************************
> ***
. 
. bysort unique_small_grid_id: egen TREAT_abs = max(downup_ac_pop)

. 
. *****************************************************************************
> ***
. * Encode string IDs if necessary
. *****************************************************************************
> ***
. 
. capture confirm numeric variable unique_small_grid_id

. if _rc {
.     encode unique_small_grid_id, gen(grid_id)
. }

. else {
.     gen grid_id = unique_small_grid_id
. }

. 
. capture confirm numeric variable ac_uq_id

. if _rc {
.     encode ac_uq_id, gen(ac_id)
. }

. else {
.     gen ac_id = ac_uq_id
. }

. 
. *****************************************************************************
> ***
. * Calculate statistics for table footer
. *****************************************************************************
> ***
. 
. * Calculate mean DV for control group (downup_ac_pop==0 & TREAT_abs==1)
. summarize countk if downup_ac_pop == 0 & TREAT_abs == 1

    Variable |        Obs        Mean    Std. dev.       Min        Max
-------------+---------------------------------------------------------
      countk |    170,862    648.7692    2237.477          0      38000

. local meandv = r(mean)

. local meandv_fmt = string(`meandv', "%9.3f")

. 
. 
. summarize countk if downup_ac_pop == 0 & TREAT_abs == 1 & rice_prod_aclvl_ahi
> gh == 1

    Variable |        Obs        Mean    Std. dev.       Min        Max
-------------+---------------------------------------------------------
      countk |     80,574    1284.496    2993.897          0      38000

. local meandv = r(mean)

. local meandv_fmt2 = string(`meandv', "%9.3f")

. 
. 
. 
. * Count unique ACs
. unique ac_id
Number of unique values of ac_id is  808
Number of records is  1536000

. local numacs = r(unique)

. 
. *****************************************************************************
> ***
. * DiD Regressions
. *****************************************************************************
> ***
. 
. * Controls
. global controls av_wind_speed wind_direction

. 
. * Cluster variables
. // egen cluster_acmonth = group(ac_id monthyear)
. 
. * Specification 1: No FE (baseline with controls only)
. reg countk i.downup_ac_pop##i.rice_prod_aclvl_ahigh $controls, vce(cluster gr
> id_id)

Linear regression                               Number of obs     =  1,536,000
                                                F(5, 76799)       =    2390.03
                                                Prob > F          =     0.0000
                                                R-squared         =     0.1071
                                                Root MSE          =     2000.6

                           (Std. err. adjusted for 76,800 clusters in grid_id)
------------------------------------------------------------------------------
             |               Robust
      countk | Coefficient  std. err.      t    P>|t|     [95% conf. interval]
-------------+----------------------------------------------------------------
1.downup_a~p |   1.047811   3.990062     0.26   0.793     -6.77269    8.868311
1.rice_pro~h |   1087.478   15.00376    72.48   0.000     1058.071    1116.885
             |
downup_ac_~p#|
rice_prod_~h |
        1 1  |  -86.47861   20.37626    -4.24   0.000     -126.416   -46.54125
             |
av_wind_sp~d |   541.5309   14.57387    37.16   0.000     512.9661    570.0956
wind_direc~n |  -10.40256    .104626   -99.43   0.000    -10.60763    -10.1975
       _cons |  -843.5879   17.15182   -49.18   0.000    -877.2053   -809.9704
------------------------------------------------------------------------------

. estadd local ymean `meandv_fmt'

added macro:
              e(ymean) : "648.769"

. estadd local ymean2 `meandv_fmt2'

added macro:
             e(ymean2) : "1284.496"

. estadd local acq `numacs'

added macro:
                e(acq) : "808"

. estadd local monthyearfe "N"

added macro:
        e(monthyearfe) : "N"

. estadd local acfe "N"

added macro:
               e(acfe) : "N"

. estadd local acmonthfe "N"

added macro:
          e(acmonthfe) : "N"

. estadd local gridfe "N"

added macro:
             e(gridfe) : "N"

. estimates store eq1

. 
. * Specification 2: AC FE + MonthYear FE
. reghdfejl countk i.downup_ac_pop##i.rice_prod_aclvl_ahigh $controls, ///
>     absorb(ac_id monthyear) ///
>     cluster(grid_id cluster_acmonth)
variable cluster_acmonth not found
r(111);

end of do-file
r(111);
