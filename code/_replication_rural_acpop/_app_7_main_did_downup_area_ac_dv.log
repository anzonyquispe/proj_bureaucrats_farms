. do _app_7_main_did_downup_area_ac_dv.do 

. *****************************************************************************
> ***
. * _app_main_did_downup_area_ac_dv_rural.do
. * Replicates _app_main_did_downup_area_ac_dv.R - RURAL GRIDS ONLY
. * Different dependent variables: Any Fire, Log Fires, Mean Brightness
. *****************************************************************************
> ***
. 
. *****************************************************************************
> ***
. * Setup - Only set globals if running standalone (not from master)
. *****************************************************************************
> ***
. 
. if "$root" == "" {
.     clear all
.     set more off
. 
.     global location "shell"
.     global sample ""
. 
.     global shell "/groups/sgulzar/sa_fires/proj_bureaucrats_farms"
.     global dbox "/Users/anzony.quisperojas/Library/CloudStorage/Dropbox/sa_fi
> res/proj_bureaucrats_farms"
. 
.     if "$location" == "dbox" {
.         global root "$dbox"
.     }
.     else {
.         global root "$shell"
.     }
. }

. 
. cd "${root}"
/groups/sgulzar/sa_fires/proj_bureaucrats_farms

. 
. *****************************************************************************
> ***
. * Import Data
. *****************************************************************************
> ***
. 
. import delimited "${root}/data_output/intermediate/0_master_merge_data_gen${s
> ample}.csv", clear
(encoding automatically selected: ISO-8859-2)
(77 vars, 14,837,592 obs)

. 
. * Merge with rural classification
. merge m:1 unique_small_grid_id using "${root}/data_output/intermediate/ghs_gr
> id_classification_2000.dta", keepusing(is_rural)

    Result                      Number of obs
    -----------------------------------------
    Not matched                        58,521
        from master                         0  (_merge==1)
        from using                     58,521  (_merge==2)

    Matched                        14,837,592  (_merge==3)
    -----------------------------------------

. keep if _merge == 3
(58,521 observations deleted)

. drop _merge

. 
. * Keep only rural grids
. keep if is_rural == 1
(3,471,192 observations deleted)

. 
. display "Observations after rural filter: " _N
Observations after rural filter: 11366400

. 
. * Drop grids with more than 1 ac
. merge m:1 unique_small_grid_id using "${root}/data_output/intermediate/grids_
> with_more_1_ac.dta"

    Result                      Number of obs
    -----------------------------------------
    Not matched                    11,356,812
        from master                11,356,780  (_merge==1)
        from using                         32  (_merge==2)

    Matched                             9,620  (_merge==3)
    -----------------------------------------

. drop if dpl_ac ==1
(9,652 observations deleted)

. drop _merge

. 
. * Create count in thousands
. gen countk = count * 1000

. 
. * Filter data: year < 2022 or (year == 2022 & month <= 8)
. keep if year < 2022 | (year == 2022 & month <= 8)
(2,148,580 observations deleted)

. 
. *****************************************************************************
> ***
. * Create dependent variables
. *****************************************************************************
> ***
. 
. * Any fire (binary)
. gen anyfire = (countk > 0)

. 
. * Log fires
. gen logfire = ln(count + 1)

. 
. * Mean brightness - replace missing with 0
. replace mean_brightness = 0 if missing(mean_brightness)
(8,751,716 real changes made)

. 
. *****************************************************************************
> ***
. * Encode IDs
. *****************************************************************************
> ***
. 
. capture confirm numeric variable unique_small_grid_id

. if _rc {
.     encode unique_small_grid_id, gen(grid_id)
. }

. else {
.     gen grid_id = unique_small_grid_id
. }

. 
. capture confirm numeric variable ac_uq_id

. if _rc {
.     encode ac_uq_id, gen(ac_id)
. }

. else {
.     gen ac_id = ac_uq_id
. }

. 
. * Create cluster variable
. egen cluster_acmonth = group(ac_id monthyear)

. 
. * Count unique ACs
. unique ac_id
Number of unique values of ac_id is  808
Number of records is  9208200

. local numacs = r(unique)

. 
. *****************************************************************************
> ***
. * Calculate Mean DV for control group (downup_ac_pop == 0)
. *****************************************************************************
> ***
. bys unique_small_grid_id: egen treat = max(downup_ac_pop)

. summarize anyfire if downup_ac_pop == 0 & treat == 1

    Variable |        Obs        Mean    Std. dev.       Min        Max
-------------+---------------------------------------------------------
     anyfire |  3,958,485    .0535707    .2251687          0          1

. local meandv1 = string(r(mean), "%9.4f")

. 
. summarize logfire if downup_ac_pop == 0  & treat == 1

    Variable |        Obs        Mean    Std. dev.       Min        Max
-------------+---------------------------------------------------------
     logfire |  3,958,485    .0651631    .3072606          0   4.204693

. local meandv2 = string(r(mean), "%9.4f")

. 
. summarize mean_brightness if downup_ac_pop == 0  & treat == 1

    Variable |        Obs        Mean    Std. dev.       Min        Max
-------------+---------------------------------------------------------
mean_brigh~s |  3,958,485    17.91544    75.34025          0      400.1

. local meandv3 = string(r(mean), "%9.2f")

. 
. *****************************************************************************
> ***
. * Run Regressions
. *****************************************************************************
> ***
. 
. global controls av_wind_speed wind_direction

. 
. * Eq1: Any Fire
. reghdfejl anyfire downup_ac_pop $controls, ///
>     absorb(grid_id ac_id#monthyear) cluster(grid_id cluster_acmonth)
(dropped 1200 singleton observations)
(MWFE estimator converged in 2 iterations)

HDFE linear regression with Julia                 Number of obs   =  9,207,000
Absorbing 2 HDFE groups                           F(   3,  76725) =      21.97
Statistics cluster-robust                         Prob > F        =     0.0000
                                                  R-squared       =     0.4622
                                                  Adj R-squared   =     0.4519
Number of clusters (grid_id) =      76725         Within R-sq.    =     0.0000
Number of clusters (cluster_acmonth) =      95760 Root MSE        =     0.1607

           (Std. err. adjusted for 76,725 clusters in grid_id cluster_acmonth)
------------------------------------------------------------------------------
             |               Robust
     anyfire | Coefficient  std. err.      t    P>|t|     [95% conf. interval]
-------------+----------------------------------------------------------------
downup_ac_~p |  -.0020017    .000257    -7.79   0.000    -.0025054   -.0014981
av_wind_sp~d |  -.0036045   .0034069    -1.06   0.290     -.010282     .003073
wind_direc~n |  -.0000152   9.50e-06    -1.60   0.110    -.0000338    3.45e-06
------------------------------------------------------------------------------

. estadd local gridfe "Y"

added macro:
             e(gridfe) : "Y"

. estadd local acmonthfe "Y"

added macro:
          e(acmonthfe) : "Y"

. estadd local ymean "`meandv1'"

added macro:
              e(ymean) : "0.0536"

. estadd local acq "`numacs'"

added macro:
                e(acq) : "808"

. est store eq1

. 
. * Eq2: Log Fires
. reghdfejl logfire downup_ac_pop $controls, ///
>     absorb(grid_id ac_id#monthyear) cluster(grid_id cluster_acmonth)
(dropped 1200 singleton observations)
(MWFE estimator converged in 2 iterations)

HDFE linear regression with Julia                 Number of obs   =  9,207,000
Absorbing 2 HDFE groups                           F(   3,  76725) =      18.96
Statistics cluster-robust                         Prob > F        =     0.0000
                                                  R-squared       =     0.6063
                                                  Adj R-squared   =     0.5988
Number of clusters (grid_id) =      76725         Within R-sq.    =     0.0000
Number of clusters (cluster_acmonth) =      95760 Root MSE        =     0.1858

           (Std. err. adjusted for 76,725 clusters in grid_id cluster_acmonth)
------------------------------------------------------------------------------
             |               Robust
     logfire | Coefficient  std. err.      t    P>|t|     [95% conf. interval]
-------------+----------------------------------------------------------------
downup_ac_~p |  -.0027459   .0003654    -7.51   0.000    -.0034622   -.0020297
av_wind_sp~d |     .00077   .0048338     0.16   0.873    -.0087042    .0102443
wind_direc~n |  -7.92e-06   .0000128    -0.62   0.537     -.000033    .0000172
------------------------------------------------------------------------------

. estadd local gridfe "Y"

added macro:
             e(gridfe) : "Y"

. estadd local acmonthfe "Y"

added macro:
          e(acmonthfe) : "Y"

. estadd local ymean "`meandv2'"

added macro:
              e(ymean) : "0.0652"

. estadd local acq "`numacs'"

added macro:
                e(acq) : "808"

. est store eq2

. 
. * Eq3: Mean Brightness
. reghdfejl mean_brightness downup_ac_pop $controls, ///
>     absorb(grid_id ac_id#monthyear) cluster(grid_id cluster_acmonth)
(dropped 1200 singleton observations)
(MWFE estimator converged in 2 iterations)

HDFE linear regression with Julia                 Number of obs   =  9,207,000
Absorbing 2 HDFE groups                           F(   3,  76725) =      22.00
Statistics cluster-robust                         Prob > F        =     0.0000
                                                  R-squared       =     0.4656
                                                  Adj R-squared   =     0.4554
Number of clusters (grid_id) =      76725         Within R-sq.    =     0.0000
Number of clusters (cluster_acmonth) =      95760 Root MSE        =    53.5772

           (Std. err. adjusted for 76,725 clusters in grid_id cluster_acmonth)
------------------------------------------------------------------------------
             |               Robust
mean_brigh~s | Coefficient  std. err.      t    P>|t|     [95% conf. interval]
-------------+----------------------------------------------------------------
downup_ac_~p |  -.6677084   .0858955    -7.77   0.000     -.836063   -.4993537
av_wind_sp~d |  -1.265756   1.128338    -1.12   0.262    -3.477292    .9457796
wind_direc~n |  -.0052844    .003163    -1.67   0.095     -.011484    .0009151
------------------------------------------------------------------------------

. estadd local gridfe "Y"

added macro:
             e(gridfe) : "Y"

. estadd local acmonthfe "Y"

added macro:
          e(acmonthfe) : "Y"

. estadd local ymean "`meandv3'"

added macro:
              e(ymean) : "17.92"

. estadd local acq "`numacs'"

added macro:
                e(acq) : "808"

. est store eq3

. 
. *****************************************************************************
> ***
. * Save ster file
. *****************************************************************************
> ***
. 
. estwrite eq* using "${root}/tex/paper/tables/_app_7_main_did_downup_area_ac_d
> v${sample}_rural_acpop.ster", replace
(saving eq1)
(saving eq2)
(saving eq3)
(file /groups/sgulzar/sa_fires/proj_bureaucrats_farms/tex/paper/tables/_app_7_m
> ain_did_downup_area_ac_dv_rural_acpop.ster saved)

. 
. display "Ster: ${root}/tex/paper/tables/_app_7_main_did_downup_area_ac_dv${sa
> mple}_rural_acpop.ster"
Ster: /groups/sgulzar/sa_fires/proj_bureaucrats_farms/tex/paper/tables/_app_7_m
> ain_did_downup_area_ac_dv_rural_acpop.ster

. 
. *****************************************************************************
> ***
. 
end of do-file
