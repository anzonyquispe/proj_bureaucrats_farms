. do _app_14_polischar_fe12_did_ricemods.do 

. *****************************************************************************
> ***
. * _app_14_polischar_fe12_did_ricemods_rural.do
. * Politician characteristics DiD with rice moderators - RURAL GRIDS ONLY
. * 3 columns: 3 FE specs (baseline only, no downup_ac_pop interaction)
. *****************************************************************************
> ***
. 
. *****************************************************************************
> ***
. * Setup - Only set globals if running standalone (not from master)
. *****************************************************************************
> ***
. 
. if "$root" == "" {
.     clear all
.     set more off
. 
.     * Set toggles for standalone run
.     global location "shell"
.     global sample ""
. 
.     global shell "/groups/sgulzar/sa_fires/proj_bureaucrats_farms"
.     global dbox "/Users/anzony.quisperojas/Library/CloudStorage/Dropbox/sa_fi
> res/proj_bureaucrats_farms"
. 
.     if "$location" == "dbox" {
.         global root "$dbox"
.     }
.     else {
.         global root "$shell"
.     }
. }

. 
. cd "${root}"
/groups/sgulzar/sa_fires/proj_bureaucrats_farms

. 
. *****************************************************************************
> ***
. * Import Data
. *****************************************************************************
> ***
. 
. import delimited using "${root}/data_output/intermediate/politicians_characte
> ristics${sample}.csv", clear varnames(1)
(encoding automatically selected: ISO-8859-9)
(19 vars, 29,740,165 obs)

. 
. * Merge with rice moderators
. merge m:1 unique_small_grid_id ac_uq_id using "${root}/data_output/intermedia
> te/rice_moderators.dta"

    Result                      Number of obs
    -----------------------------------------
    Not matched                        23,982
        from master                         0  (_merge==1)
        from using                     23,982  (_merge==2)

    Matched                        29,740,165  (_merge==3)
    -----------------------------------------

. keep if _merge == 3
(23,982 observations deleted)

. drop _merge

. 
. * Merge with rural classification
. merge m:1 unique_small_grid_id using "${root}/data_output/intermediate/ghs_gr
> id_classification_2000.dta", keepusing(is_rural)

    Result                      Number of obs
    -----------------------------------------
    Not matched                        82,479
        from master                         0  (_merge==1)
        from using                     82,479  (_merge==2)

    Matched                        29,740,165  (_merge==3)
    -----------------------------------------

. keep if _merge == 3
(82,479 observations deleted)

. drop _merge

. 
. * Keep only rural grids
. keep if is_rural == 1
(7,857,656 observations deleted)

. 
. display "Observations after rural filter: " _N
Observations after rural filter: 21882509

. 
. * Drop grids with more than 1 ac
. merge m:1 unique_small_grid_id using "${root}/data_output/intermediate/grids_
> with_more_1_ac.dta"

    Result                      Number of obs
    -----------------------------------------
    Not matched                    21,854,655
        from master                21,854,616  (_merge==1)
        from using                         39  (_merge==2)

    Matched                            27,893  (_merge==3)
    -----------------------------------------

. drop if dpl_ac ==1
(27,932 observations deleted)

. drop _merge

. 
. *----------------------------------------------------------------------------
> ---
. * Merge in downup_ac_pop from master data (not present in this dataset)
. *----------------------------------------------------------------------------
> ---
. preserve

. import delimited "${root}/data_output/intermediate/0_master_merge_data_gen${s
> ample}.csv", ///
>     clear varnames(1)
(encoding automatically selected: ISO-8859-2)
(77 vars, 14,837,592 obs)

. keep unique_small_grid_id year month downup_ac_pop

. duplicates drop unique_small_grid_id year month, force

Duplicates in terms of unique_small_grid_id year month

(0 observations are duplicates)

. tempfile downup_ac_pop_lookup

. save `downup_ac_pop_lookup'
file /tmp/934200.1.largemem/stata.934200/St317099.000002 saved as .dta format

. restore

. merge m:1 unique_small_grid_id year month using `downup_ac_pop_lookup', ///
>     keep(master match) keepusing(downup_ac_pop) nogen

    Result                      Number of obs
    -----------------------------------------
    Not matched                             0
    Matched                        21,854,616  
    -----------------------------------------

. 
. *****************************************************************************
> ***
. * Generate Variables
. *****************************************************************************
> ***
. 
. * Date
. gen date_ym = ym(year, month)

. 
. * Fixed Effects
. egen unique_small_grid_id_cohort = group(unique_small_grid_id cohort)

. egen monthyearco = group(month year cohort)

. egen ac_elec_yr = group(ac_uq_id election_year cohort)

. egen province_cohort = group(cohort province)

. 
. 
. * Government year
. bys ac_uq_id election_year: egen min_monthyear = min(date_ym)

. gen gov_year = date_ym - min_monthyear

. replace gov_year = gov_year / 12
(21,414,087 real changes made)

. 
. * Relative years
. sum relative_year_bin

    Variable |        Obs        Mean    Std. dev.       Min        Max
-------------+---------------------------------------------------------
relative_y~n | 21,854,616   -.3913651    2.647741         -5          4

. local rmin = r(min)

. gen relative_year_bin_aux = relative_year_bin - `rmin' + 1

. local base = -1 - `rmin' + 1

. gen post_ = (relative_year_bin >= 0)

. 
. * Ever treated
. bys unique_small_grid_id: egen TREAT_down = max(downup_ac_pop)

. 
. *****************************************************************************
> ***
. * Regression Setup
. *****************************************************************************
> ***
. gen countk = count * 1000

. local dep_var countk

. 
. 
. * FE specifications
. local dep_var countk

. local rhs "wind_direction av_wind_speed"

. local fe12 "unique_small_grid_id_cohort relative_year_bin_aux province_cohort
> #election_year province_cohort#c.monthyear"

. 
. unique ac_uq_id
Number of unique values of ac_uq_id is  650
Number of records is  21854616

. local numacs = r(unique)

. gen moderator = 0

. local mods_list moderator rice_area_aclvl_ahigh rice_harvarea_aclvl_ahigh ric
> e_prod_aclvl_ahigh

. *****************************************************************************
> ***
. * Run Regressions
. *****************************************************************************
> ***
. 
. local i = 1

. 
. foreach mod of local mods_list {
  2. 
.         quietly summarize `dep_var' if treat == 1 & post_ == 0
  3.         local ymean = cond(r(N) == 0, " ", string(r(mean), "%9.3f"))
  4. 
.         quietly summarize `dep_var' if treat == 1 & post_ == 0 & `mod' == 1
  5.         local ymean2 = cond(r(N) == 0, " ", string(r(mean), "%9.3f"))
  6.         
.         quietly summarize `dep_var' if treat == 1 & post_ == 0 & `mod' == 0
  7.         local ymean3 = cond(r(N) == 0, " ", string(r(mean), "%9.3f"))
  8. 
.         reghdfejl `dep_var' ib0.post_##ib0.treat##ib0.`mod' `rhs', absorb(`fe
> 12') cluster(ac_elec_yr)
  9. 
.         * Store FE indicators
.         estadd local gridfe "Y"
 10.         estadd local time "Y"
 11.         estadd local electionfe "Y"
 12.         estadd local provtrendfe "Y"
 13.         estadd local ymean "`ymean'"
 14.         estadd local ymean2 "`ymean2'"
 15.         estadd local ymean3 "`ymean3'"
 16.         estadd scalar acq `numacs'
 17. 
.         est store evreg`i'
 18.         local i = `i' + 1
 19. 
. }
