. do _app_16_polischar_fe12_evst_all.do 

. *----------------------------------------------------------------------------
> ---
. * _app_16_polischar_fe12_evst_all_rural.do
. * Politician Characteristics Event Study - RURAL GRIDS ONLY
. * Output: _app_16_polischar_fe12_evst_all_rural_acpop.csv
. *----------------------------------------------------------------------------
> ---
. 
. *****************************************************************************
> ***
. * Setup - Only set globals if running standalone (not from master)
. *****************************************************************************
> ***
. 
. if "$root" == "" {
.     clear all
.     set more off
. 
.     * Set toggles for standalone run
.     global location "shell"
.     global sample ""
. 
.     * DATA roots
.     global shell "/groups/sgulzar/sa_fires/proj_bureaucrats_farms"
.     global dbox  "/Users/anzony.quisperojas/Library/CloudStorage/Dropbox/sa_f
> ires/proj_bureaucrats_farms"
. 
.     * CODE roots (code is NOT a subpath of data root on either machine)
.     global code_shell "/users/aquisper/proj_bureaucrats_farms/code/_replicati
> on_rural_acpop"
.     global code_dbox  "/Users/anzony.quisperojas/Documents/GitHub/proj_bureau
> crats_farms/code/_replication_rural_acpop"
. 
.     if "$location" == "dbox" {
.         global root "$dbox"
.         global code "$code_dbox"
.     }
.     else {
.         global root "$shell"
.         global code "$code_shell"
.     }
. 
.     * Load custom ado for exporting results
.     qui do "${code}/estsave_csv.ado"
. 
. }

. 
. 
. *----------------------------------------------------------------------------
> ---
. * Import and Merge Data
. *----------------------------------------------------------------------------
> ---
. 
. * Import politician characteristics data
. import delimited using "${root}/data_output/intermediate/politicians_characte
> ristics${sample}.csv", clear varnames(1)
(encoding automatically selected: ISO-8859-9)
(19 vars, 29,740,165 obs)

. 
. * Merge with rice moderators
. merge m:1 unique_small_grid_id ac_uq_id using "${root}/data_output/intermedia
> te/rice_moderators.dta"

    Result                      Number of obs
    -----------------------------------------
    Not matched                        23,982
        from master                         0  (_merge==1)
        from using                     23,982  (_merge==2)

    Matched                        29,740,165  (_merge==3)
    -----------------------------------------

. keep if _merge == 3
(23,982 observations deleted)

. drop _merge

. 
. * Merge with rural classification
. merge m:1 unique_small_grid_id using "${root}/data_output/intermediate/ghs_gr
> id_classification_2000.dta", keepusing(is_rural)

    Result                      Number of obs
    -----------------------------------------
    Not matched                        82,479
        from master                         0  (_merge==1)
        from using                     82,479  (_merge==2)

    Matched                        29,740,165  (_merge==3)
    -----------------------------------------

. keep if _merge == 3
(82,479 observations deleted)

. drop _merge

. 
. * Keep only rural grids
. keep if is_rural == 1
(7,857,656 observations deleted)

. 
. display "Observations after rural filter: " _N
Observations after rural filter: 21882509

. 
. * Drop grids with more than 1 ac
. merge m:1 unique_small_grid_id using "${root}/data_output/intermediate/grids_
> with_more_1_ac.dta"

