.         global root "$dbox"
.         global code "$code_dbox"
.     }
.     else {
.         global root "$shell"
.         global code "$code_shell"
.     }
. }

. 
. global tables "${code}/../../tables"

. 
. *****************************************************************************
> ***
. * Helper: strip trailing zeros from one or more e()-stored stats.
. *****************************************************************************
> ***
. 
. capture program drop _strip_zeros_stats

. program define _strip_zeros_stats
  1.     syntax , Models(string) Stats(string)
  2.     foreach m of local models {
  3.         capture estimates restore `m'
  4.         if _rc continue
  5.         foreach s of local stats {
  6.             capture local rnum = e(`s')
  7.             if _rc continue
  8.             local raw = strtrim(string(`rnum', "%9.3f"))
  9.             local cleaned = regexr(regexr("`raw'", "0+$", ""), "\.$", "")
 10.             estadd local `s'_clean "`cleaned'"
 11.         }
 12.         estimates store `m'
 13.     }
 14. end

. 
. * The stacked main-DiD ster files predate reliable string-local roundtripping
. * through estread. Reattach the known FE tags so the original Y/N rows render
> .
. capture program drop _set_main_fe_tags

. program define _set_main_fe_tags
  1.     forvalues i = 1/4 {
  2.         local monthyearfe "N"
  3.         local acfe "N"
  4.         local acmonthfe "N"
  5.         local gridfe "N"
  6.         if `i' == 2 {
  7.             local monthyearfe "Y"
  8.             local acfe "Y"
  9.         }
 10.         if `i' == 3 local acmonthfe "Y"
 11.         if `i' == 4 {
 12.             local acmonthfe "Y"
 13.             local gridfe "Y"
 14.         }
 15.         estimates restore eq`i'
 16.         estadd local monthyearfe "`monthyearfe'", replace
 17.         estadd local acfe "`acfe'", replace
 18.         estadd local acmonthfe "`acmonthfe'", replace
 19.         estadd local gridfe "`gridfe'", replace
 20.         estimates store eq`i'
 21.     }
 22. end

. 
. 
. * Program to add a lincom result with stars + SE in parentheses
. capture program drop _add_lincom

. program define _add_lincom
  1.     args k   // suffix number for the stored stat
  2.     local b  = r(estimate)
  3.     local se = r(se)
  4.     * two-sided p-value (use r(df) if available, otherwise normal)
.     if r(df) != . & r(df) > 0 {
  5.         local p = 2*ttail(r(df), abs(`b'/`se'))
  6.     }
  7.     else {
  8.         local p = 2*normal(-abs(`b'/`se'))
  9.     }
 10.     local stars ""
 11.     if `p' < 0.01      local stars "\sym{***}"
 12.     else if `p' < 0.05 local stars "\sym{**}"
 13.     else if `p' < 0.10 local stars "\sym{*}"
 14.     estadd local ysum`k' = string(`b', "%12.3fc") + "`stars'"
 15.     estadd local ysd`k'  = "(" + string(`se', "%12.3fc") + ")"
 16. end

. 
