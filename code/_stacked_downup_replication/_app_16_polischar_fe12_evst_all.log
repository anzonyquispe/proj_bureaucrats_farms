. do _app_16_polischar_fe12_evst_all.do 

. *----------------------------------------------------------------------------
> ---
. * _app_16_polischar_fe12_evst_all_rural.do
. * Politician Characteristics Event Study - RURAL GRIDS ONLY
. * Output: _app_16_polischar_fe12_evst_all_rural.csv
. *----------------------------------------------------------------------------
> ---
. 
. *****************************************************************************
> ***
. * Setup - Only set globals if running standalone (not from master)
. *****************************************************************************
> ***
. 
. if "$root" == "" {
.     clear all
.     set more off
. 
.     * Set toggles for standalone run
.     global location "shell"
.     global sample ""
. 
.     global shell "/groups/sgulzar/sa_fires/proj_bureaucrats_farms"
.     global dbox "/Users/anzony.quisperojas/Library/CloudStorage/Dropbox/sa_fi
> res/proj_bureaucrats_farms"
. 
.     if "$location" == "dbox" {
.         global root "$dbox"
.     }
.     else {
.         global root "$shell"
.     }
.         * Load custom ado for exporting results
.         qui do "${root}/code/_replication_rural/estsave_csv.ado"
. 
. }

. 
. 
. *----------------------------------------------------------------------------
> ---
. * Import and Merge Data
. *----------------------------------------------------------------------------
> ---
. 
. // Importing data from csv
. import delimited using "${root}/data_output/intermediate/politicians_characte
> ristics${sample}.csv", ///
>     clear varnames(1)
(encoding automatically selected: ISO-8859-9)
(19 vars, 29,740,165 obs)

.         
.         drop downup_ac 

. 
. preserve

.                 import delimited using "${root}/data_output/intermediate/0_ma
> ster_dataset.csv", ///
>     clear varnames(1)
(encoding automatically selected: ISO-8859-1)
(66 vars, 14,837,592 obs)

.                 keep unique_small_grid_id month year downup_ac_pop

.                 tempfile dta

.                 save `dta'
file /tmp/1321605.1.largemem/St2134508.000002 saved as .dta format

.         restore

.         
.         merge m:1 unique_small_grid_id month year using `dta', keep(3) nogen

    Result                      Number of obs
    -----------------------------------------
    Not matched                             0
    Matched                        29,740,165  
    -----------------------------------------

.         
.         rename  downup_ac_pop downup_ac

. 
. * Merge with rice moderators
. merge m:1 unique_small_grid_id ac_uq_id using "${root}/data_output/intermedia
> te/rice_moderators.dta"

    Result                      Number of obs
    -----------------------------------------
    Not matched                        23,982
        from master                         0  (_merge==1)
        from using                     23,982  (_merge==2)

    Matched                        29,740,165  (_merge==3)
    -----------------------------------------

. keep if _merge == 3
(23,982 observations deleted)

. drop _merge

. 
. * Merge with rural classification
. merge m:1 unique_small_grid_id using "${root}/data_output/intermediate/ghs_gr
> id_classification_2000.dta", keepusing(is_rural)

    Result                      Number of obs
    -----------------------------------------
    Not matched                        82,479
        from master                         0  (_merge==1)
        from using                     82,479  (_merge==2)

    Matched                        29,740,165  (_merge==3)
    -----------------------------------------

. keep if _merge == 3
(82,479 observations deleted)

. drop _merge

. 
. * Keep only rural grids
. keep if is_rural == 1
(7,857,656 observations deleted)

. 
. display "Observations after rural filter: " _N
Observations after rural filter: 21882509

. 
. *----------------------------------------------------------------------------
> ---
. * Generate Variables
. *----------------------------------------------------------------------------
> ---
. 
. * Date
. gen date_ym = ym(year, month)

. 
. * Generation of Fixed Effects
. egen unique_small_grid_id_cohort = group(unique_small_grid_id cohort)

. egen monthyearco = group(month year cohort)

. egen ac_elec_yr = group(ac_uq_id election_year cohort)

. egen province_cohort = group(cohort province)

. 
. * Government year
. bys ac_uq_id election_year: egen min_monthyear = min(date_ym)

. gen gov_year = date_ym - min_monthyear

. replace gov_year = gov_year / 12
(21,441,362 real changes made)

. g yeargov = int(gov_year + 1)

. 
. * Generation of Relative Years
. sum relative_year_bin

    Variable |        Obs        Mean    Std. dev.       Min        Max
-------------+---------------------------------------------------------
relative_y~n | 21,882,509   -.3912998    2.647744         -5          4

. local rmin = r(min)

. gen relative_year_bin_aux = relative_year_bin - `rmin' + 1

. local base = -1 - `rmin' + 1

. dis `base'
5

. g post_ = (relative_year_bin >= 0)

. 
. *----------------------------------------------------------------------------
> ---
. * Regression Setup
. *----------------------------------------------------------------------------
> ---
. 
. gen countk = count * 1000

. local dep_var countk

. 
. 
. * FE13 specification
. local fe12 "unique_small_grid_id_cohort province_cohort#c.monthyear province_
> cohort#election_year"

. 
. * Filters
. local filter1 "1"   // all sample

. 
. * Moderator variables
. local moderators_list moderator downup_ac rice_area_aclvl_ahigh rice_harvarea
> _aclvl_ahigh rice_prod_aclvl_ahigh

. 
. *----------------------------------------------------------------------------
> ---
. * Loop over moderators
. *----------------------------------------------------------------------------
> ---
. 
. local i = 1

. gen moderator = 0

. 
. foreach mod of local moderators_list {
  2.         
.         local rhs "ib`base'.relative_year_bin_aux##ib0.treat##ib0.`mod' wind_
> direction av_wind_speed"
  3. 
.     replace moderator = `mod'
  4. 
.     * Select filter condition
.     local fcond `filter1'
  5. 
.     * Compute mean of dep var where untreated
.     quietly summarize `dep_var' if `fcond' & treat == 0 & relative_year_bin <
>  0
  6.     local ymean = r(mean)
  7. 
.     * Count number of unique ACs in subsample
.     unique ac_uq_id if `fcond'
  8.     local numacs = r(unique)
  9. 
.     * Select FE spec
.     local fespec `fe12'
 10. 
.     * Run regression with clustering
.     reghdfejl `dep_var' `rhs' if `fcond', absorb(`fespec') vce(cluster ac_ele
> c_yr)
 11. 
.     * Store coefficient + SE of main var
.     est store evreg`i'
 12.     estadd scalar ymean = `ymean'
 13.     estadd scalar acq = `numacs'
 14.     estadd local sample "Rural"
 15.     * FE indicators for FE13 specification
.     estadd local gridfe "Y"
 16.     estadd local mtyr "Y"
 17.     estadd local provtrend "Y"
 18.     estadd local yeargov "Y"
 19. 
.     local i = `i' + 1
 20.     display("`i'")
 21. }
