. est clear

. local i = 1

. foreach mod of local moderators_list {
  2.     replace moderator = `mod'
  3.     local rhs "ib0.post_##ib0.treat##ib0.`mod' wind_direction av_wind_spee
> d"
  4.     quietly summarize countk if treat == 1 & relative_year_bin <= -1
  5.     local ymean = r(mean)
  6.     quietly summarize countk if treat == 1 & relative_year_bin <= -1 & mod
> erator == 1
  7.     local ymean2 = r(mean)
  8.     foreach fe of numlist $fe_list {
  9.         reghdfejl countk `rhs', absorb(`fe`fe'') vce(cluster ac_elec_yr)
 10.         if e(N) != `common_n' {
 11.             display as error "FE specification `fe' with moderator `mod' c
> hanged the anchored sample."
 12.             exit 459
 13.         }
 14.         estadd scalar ymean = `ymean'
 15.         estadd scalar ymean2 = `ymean2'
 16.         estadd scalar acq = `numacs'
 17.         estadd local smpl "Rural"
 18.         estadd local fespec "`fe`fe''"
 19.         estadd local gridfe "Y"
 20.         estadd local time "Y"
 21.         local election_label = cond(`fe' >= 2, "Y", "N")
 22.         local provtrend_label = cond(`fe' == 3, "Y", "N")
 23.         estadd local electionfe "`election_label'"
 24.         estadd local provtrendfe "`provtrend_label'"
 25.         estadd local mod "`mod'"
 26.         local estname evreg`i'
 27.         local i = `i' + 1
 28.         est store `estname'
 29.     }
 30. }
