. keep if year < 2022 | (year == 2022 & month <= 8)
(36,592,248 observations deleted)

. 
. egen unique_small_grid_id_cohort = group(unique_small_grid_id cohort)

. egen province_cohort = group(province cohort)

. egen ac_elec_yr = group(ac_uq_id election_year cohort)

. gen post_ = relative_year_bin >= 0

. gen moderator = 0

. 
. local fe1 "unique_small_grid_id_cohort relative_year_bin"

. local fe2 "unique_small_grid_id_cohort relative_year_bin province_cohort#elec
> tion_year"

. local fe3 "unique_small_grid_id_cohort relative_year_bin province_cohort#elec
> tion_year province_cohort#c.monthyear"

. local moderators_list moderator ${downup_var}

. egen tag_ac = tag(ac_uq_id)

. count if tag_ac == 1
  808

. local numacs = r(N)

. 
. est clear

. local i = 1

. foreach mod of local moderators_list {
  2.     replace moderator = `mod'
  3.     local rhs "ib0.post_##ib0.treat##ib0.`mod' wind_direction av_wind_spee
> d"
  4.     quietly summarize countk if treat == 1 & relative_year_bin <= -1
  5.     local ymean = r(mean)
  6.     quietly summarize countk if treat == 1 & relative_year_bin <= -1 & mod
> erator == 1
  7.     local ymean2 = r(mean)
  8.     foreach fe of numlist $fe_list {
  9.         reghdfejl countk `rhs', absorb(`fe`fe'') vce(cluster ac_elec_yr)
 10.         estadd scalar ymean = `ymean'
 11.         estadd scalar ymean2 = `ymean2'
 12.         estadd scalar acq = `numacs'
 13.         estadd local smpl "Rural"
 14.         estadd local gridfe "Y"
 15.         estadd local time "Y"
 16.         local election_label = cond(`fe' >= 2, "Y", "N")
 17.         local provtrend_label = cond(`fe' == 3, "Y", "N")
 18.         estadd local electionfe "`election_label'"
 19.         estadd local provtrendfe "`provtrend_label'"
 20.         estadd local mod "`mod'"
 21.         local estname evreg`i'
 22.         local i = `i' + 1
 23.         est store `estname'
 24.     }
 25. }
