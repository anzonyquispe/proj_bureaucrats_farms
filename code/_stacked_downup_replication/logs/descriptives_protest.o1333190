  8.     _fmt_int `uval'
  9.     local ufmt "`r(out)'"
 10. 
.     local meanfmt ""
 11.     local sdfmt ""
 12.     local minfmt ""
 13.     local maxfmt ""
 14.     if strpos(" `contvars' ", " `v' ") {
 15.         quietly summarize `v'
 16.         _fmt_num `r(mean)'
 17.         local meanfmt "`r(out)'"
 18.         _fmt_num `r(sd)'
 19.         local sdfmt "`r(out)'"
 20.         _fmt_num `r(min)'
