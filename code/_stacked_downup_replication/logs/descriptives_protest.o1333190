 22.         _fmt_num `r(max)'
 23.         local maxfmt "`r(out)'"
 24.     }
 25.     local vlabel "`lab_`v''"
 26.     file write texout "`vlabel' & `meanfmt' & `sdfmt' & `minfmt' & `maxfmt
> ' & `Nfmt' & `ufmt'\\\\" _n
 27. }

. 
