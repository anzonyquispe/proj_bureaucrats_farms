 17.         local provtrend_label = cond(`fe' == 3, "Y", "N")
 18.         estadd local electionfe "`election_label'"
 19.         estadd local provtrendfe "`provtrend_label'"
 20.         estadd local mod "`mod'"
 21.         local estname evreg`i'
