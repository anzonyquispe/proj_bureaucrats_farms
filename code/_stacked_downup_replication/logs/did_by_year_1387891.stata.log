. *****************************************************************************
> ***
. * Run Regressions by Agricultural Year (Sep-Aug)
. *****************************************************************************
> ***
. 
. global controls av_wind_speed wind_direction

. 
. * Store year labels for table header
. local yearlabels ""

. 
. local i = 1

. forvalues yr = 2012/2021 {
  2. 
.     local yr_next = `yr' + 1
  3. 
.     * Define agricultural year: Sep of yr to Aug of yr+1
.     * (year == yr & month >= 9) | (year == yr+1 & month <= 8)
. 
.         preserve
  4.                 keep if (year == `yr' & month >= 9) | (year == `yr_next' &
>  month <= 8)
  5. 
.                 * Run regression
.                 reghdfejl countk downup_ac_pop $controls , ///
>                         absorb(grid_id#cohort ac_id#monthyear#cohort) cluster
> ($cluster )
  6.                 gen byte year_sample = e(sample)
  7. 
.                 * All table statistics describe the exact regression sample w
> ithin the
.                 * canonical specification-4 population sample.
.                 egen byte tag_ac = tag(ac_id) if year_sample == 1
  8.                 quietly count if tag_ac == 1
  9.                 local numacs`i' = r(N)
 10.                 gen byte moderator = 0
 11.                 quietly summarize countk if treat == 1 & relative_monthyea
> r <= -1 & year_sample == 1
 12.                 local meandv`i' = r(mean)
 13.                 quietly summarize countk if treat == 1 & relative_monthyea
> r <= -1 & moderator == 1 & year_sample == 1
 14.                 local meandv2`i' = r(mean)
 15. 
.                 * Store statistics
.                 estadd local gridfe "Y"
 16.                 estadd local acmonthfe "Y"
 17.                 estadd scalar ymean = `meandv`i''
 18.                 estadd scalar ymean2 = `meandv2`i''
 19.                 estadd scalar acq = `numacs`i''
 20.                 est store eq`i'
 21.                 
.     restore
 22. 
.     * Build year label
.     local yearlabels "`yearlabels' `yr'/`yr_next'"
 23. 
.     local i = `i' + 1
 24. }
