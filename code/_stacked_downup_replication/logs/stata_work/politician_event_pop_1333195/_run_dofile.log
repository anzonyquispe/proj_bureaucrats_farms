.     egen tag_ac = tag(ac_uq_id)
 16.     count if tag_ac == 1
 17.     local numacs = r(N)
 18. 
.     est clear
 19.     local i = 1
 20.     foreach mod of local moderators_list {
 21.         replace moderator = `mod'
 22.         local rhs "ib`base'.relative_year_bin_aux##ib0.treat##ib0.`mod' wi
> nd_direction av_wind_speed"
 23.         local fcond `filter1'
 24. 
.         quietly summarize countk if treat == 1 & relative_year_bin <= -1 & `f
> cond'
 25.         local ymean = r(mean)
 26.         quietly summarize countk if treat == 1 & relative_year_bin <= -1 &
>  moderator == 1 & `fcond'
 27.         local ymean2 = r(mean)
 28. 
.         foreach fe of numlist $fe_list {
 29.             local fespec `fe`fe''
 30.             reghdfejl countk `rhs' if `fcond', ///
>                 absorb(`fespec') vce(cluster ac_elec_yr)
 31. 
.             estadd scalar ymean  = `ymean'
 32.             estadd scalar ymean2 = `ymean2'
 33.             estadd scalar acq    = `numacs'
 34.             estadd local smpl "Rural"
 35.             estadd local fespec "fe`fe'"
 36.             estadd local mod "`mod'"
 37.             estadd local controls "`control_sample'"
 38.             local estname evreg`i'
 39.             local i = `i' + 1
 40.             est store `estname'
 41.         }
 42.     }
 43. 
.     local outbase "${tables}/_app_16_polischar_fe12_evst_all${sample}_rural${
> ster_suffix}`control_suffix'"
 44.     estwrite evreg* using "`outbase'.ster", replace
 45.     estsave_csv evreg* using "`outbase'.csv", replace
 46.     display as result "Saved: `outbase'.ster and `outbase'.csv"
 47. }
