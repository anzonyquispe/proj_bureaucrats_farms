.     local outbase "${tables}/_app_16_polischar_fe12_evst_all${sample}_rural${
> ster_suffix}`control_suffix'"
 51.     estwrite evreg* using "`outbase'.ster", replace
 52.     estsave_csv `estimate_names' using "`outbase'.csv", replace
 53.     confirm file "`outbase'.ster"
