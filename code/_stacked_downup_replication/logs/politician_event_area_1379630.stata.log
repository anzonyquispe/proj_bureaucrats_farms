 41.             estadd local fespec "fe`fe'"
 42.             estadd local mod "`mod'"
 43.             estadd local controls "`control_sample'"
 44.             local estname evreg`i'
 45.             local i = `i' + 1
 46.             est store `estname'
 47.             local estimate_names "`estimate_names' `estname'"
 48.         }
 49.     }
 50. 
.     local outbase "${tables}/_app_16_polischar_fe12_evst_all${sample}_rural${
> ster_suffix}`control_suffix'"
 51.     estwrite evreg* using "`outbase'.ster", replace
 52.     estsave_csv `estimate_names' using "`outbase'.csv", replace
 53.     confirm file "`outbase'.ster"
 54.     confirm file "`outbase'.csv"
 55.     confirm file "`outbase'_scalars.csv"
 56.     display as result "Saved: `outbase'.ster and `outbase'.csv"
 57. }
