. *! estsave_csv v1.2 - Export stored estimates and covariance matrices to CSV
. program define estsave_csv
  1.     version 14.0
  2.     syntax namelist using/, [replace append]
  3. 
.     local outfile `"`using'"'
  4.     tempfile coef_all coef_cur scalar_all scalar_cur
  5.     local first = 1
  6. 
.     foreach est of local namelist {
  7.         quietly estimates restore `est'
  8.         matrix b = e(b)
  9.         matrix V = e(V)
 10.         local k = colsof(b)
 11.         local cnames : colfullnames b
 12. 
.         preserve
 13.         clear
 14.         quietly set obs `k'
 15.         gen strL reg = "`est'"
 16.         gen strL var = ""
 17.         gen double beta = .
 18.         capture local ymean_val `"`e(ymean)'"'
 19.         if !_rc & `"`ymean_val'"' != "" gen strL ymean = `"`ymean_val'"'
 20.         else gen strL ymean = ""
 21. 
.         forvalues j = 1/`k' {
 22.             local nm : word `j' of `cnames'
 23.             quietly replace var = "`nm'" in `j'
 24.             quietly replace beta = b[1, `j'] in `j'
 25.             gen double cov`j' = .
 26.         }
 27.         forvalues i = 1/`k' {
 28.             forvalues j = 1/`k' {
 29.                 quietly replace cov`j' = V[`i', `j'] in `i'
 30.             }
 31.         }
 32.         quietly save `coef_cur', replace
 33.         if `first' quietly save `coef_all', replace
 34.         else {
 35.             quietly use `coef_all', clear
 36.             quietly append using `coef_cur'
 37.             quietly save `coef_all', replace
 38.         }
 39.         restore
 40. 
.         preserve
 41.         clear
 42.         quietly set obs 1
 43.         gen strL reg = "`est'"
 44.         local escalars : e(scalars)
 45.         foreach sc of local escalars {
 46.             local scval = e(`sc')
 47.             local safe = subinstr("`sc'", "-", "_", .)
 48.             capture gen double `safe' = `scval'
 49.             if _rc capture gen double sc_`safe' = `scval'
 50.         }
 51.         local emacros : e(macros)
 52.         foreach mc of local emacros {
 53.             capture local mcval `"`e(`mc')'"'
 54.             if !_rc & `"`mcval'"' != "" {
 55.                 if strlen(`"`mcval'"') > 244 local mcval = substr(`"`mcval
> '"', 1, 244)
 56.                 local safe = subinstr("`mc'", "-", "_", .)
 57.                 capture gen strL `safe' = `"`mcval'"'
 58.                 if _rc capture gen strL mc_`safe' = `"`mcval'"'
 59.             }
 60.         }
 61.         quietly save `scalar_cur', replace
 62.         if `first' {
 63.             quietly save `scalar_all', replace
 64.             local first = 0
 65.         }
 66.         else {
 67.             quietly use `scalar_all', clear
 68.             quietly append using `scalar_cur'
 69.             quietly save `scalar_all', replace
 70.         }
 71.         restore
 72.     }
 73. 
.     local basefile = subinstr(`"`outfile'"', ".csv", "", .)
 74.     quietly use `coef_all', clear
 75.     order reg var beta ymean
 76.     quietly export delimited using "`basefile'.csv", `replace' `append'
 77.     quietly use `scalar_all', clear
 78.     quietly export delimited using "`basefile'_scalars.csv", `replace' `ap
> pend'
 79.     display as result "Estimates exported to `basefile'.csv"
 80. end

. 
. 
end of do-file

. capture noisily do "${code}/estload_csv.ado"

. *! estload_csv v1.0 - Reconstruct estimate objects exported by estsave_csv
. program define estload_csv
  1.     version 14.0
  2.     syntax using/
  3. 
.     local infile `"`using'"'
  4.     local basefile = subinstr(`"`infile'"', ".csv", "", .)
  5.     preserve
  6.     quietly import delimited using "`basefile'.csv", clear varnames(1)
  7.     quietly levelsof reg, local(regs)
  8. 
.     foreach r of local regs {
  9.         preserve
 10.         quietly keep if reg == "`r'"
 11.         local k = _N
 12.         matrix b = J(1, `k', .)
 13.         matrix V = J(`k', `k', .)
 14.         local varnames ""
 15.         forvalues i = 1/`k' {
 16.             local vname = var[`i']
 17.             local varnames `"`varnames' `vname'"'
 18.             matrix b[1, `i'] = beta[`i']
 19.             forvalues j = 1/`k' {
 20.                 matrix V[`i', `j'] = cov`j'[`i']
 21.             }
 22.         }
 23.         matrix colnames b = `varnames'
 24.         matrix rownames V = `varnames'
 25.         matrix colnames V = `varnames'
 26.         restore, preserve
 27.         quietly ereturn post b V
 28.         estimates store `r'
 29.         display as text "Loaded estimate: `r'"
 30.     }
 31.     restore
 32. end

. 
. 
end of do-file

