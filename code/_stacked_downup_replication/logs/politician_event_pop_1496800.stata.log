 48.             estadd local mod "`mod'"
 49.             estadd local controls "`control_sample'"
 50.             local estname evreg`i'
 51.             local i = `i' + 1
 52.             est store `estname'
 53.             local estimate_names "`estimate_names' `estname'"
 54.         }
 55.     }
 56. 
.     local outbase "${tables}/_app_16_polischar_fe12_evst_all${sample}_rural${
> ster_suffix}`control_suffix'"
 57.     estwrite evreg* using "`outbase'.ster", replace
 58.     confirm file "`outbase'.ster"
 59.     display as result "Saved: `outbase'.ster"
 60. }
