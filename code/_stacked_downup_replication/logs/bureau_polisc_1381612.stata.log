. *! estload_csv v1.0 - Reconstruct estimate objects exported by estsave_csv
. program define estload_csv
  1.     version 14.0
  2.     syntax using/
  3. 
.     local infile `"`using'"'
  4.     local basefile = subinstr(`"`infile'"', ".csv", "", .)
  5.     preserve
  6.     quietly import delimited using "`basefile'.csv", clear varnames(1)
  7.     quietly levelsof reg, local(regs)
  8. 
.     foreach r of local regs {
  9.         preserve
 10.         quietly keep if reg == "`r'"
 11.         local k = _N
 12.         matrix b = J(1, `k', .)
 13.         matrix V = J(`k', `k', .)
 14.         local varnames ""
 15.         forvalues i = 1/`k' {
 16.             local vname = var[`i']
 17.             local varnames `"`varnames' `vname'"'
 18.             matrix b[1, `i'] = beta[`i']
 19.             forvalues j = 1/`k' {
 20.                 matrix V[`i', `j'] = cov`j'[`i']
 21.             }
 22.         }
 23.         matrix colnames b = `varnames'
 24.         matrix rownames V = `varnames'
 25.         matrix colnames V = `varnames'
 26.         restore, preserve
 27.         quietly ereturn post b V
 28.         estimates store `r'
 29.         display as text "Loaded estimate: `r'"
 30.     }
 31.     restore
 32. end

. 
. 
end of do-file

