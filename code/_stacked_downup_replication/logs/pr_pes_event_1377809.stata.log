. foreach fe of numlist $fe_list {
  2.     local fespec `fe`fe''
  3.     display _newline as text "FE`fe': `fespec' + relativeyear_cohort"
  4. 
.     foreach mod of local moderators_list {
  5.         replace moderator = `mod'
  6.         local rhs ///
>             "ib`base'.relative_year_bin_aux##ib0.treat##ib0.`mod' wind_direct
> ion av_wind_speed"
  7. 
.         quietly summarize `dep_var' if treat == 1 & relative_year_bin <= -1 &
>  `filter1'
  8.         local ymean = r(mean)
  9.         quietly summarize `dep_var' if treat == 1 & relative_year_bin <= -
> 1 & moderator == 1 & `filter1'
 10.         local ymean2 = r(mean)
 11. 
.         reghdfejl `dep_var' `rhs' if `filter1', ///
>             absorb(`fespec' relativeyear_cohort) ///
>             vce(cluster ac_elec_yr)
 12. 
.         estadd scalar ymean  = `ymean'
 13.         estadd scalar ymean2 = `ymean2'
 14.         estadd scalar acq    = `numacs'
 15.         estadd local smpl "Rural"
 16.         estadd local fespec "FE`fe': `fespec' relativeyear_cohort"
 17.         estadd local mod "`mod'"
 18.         estadd local controls "pooled"
 19. 
.         local estname evreg`i'
 20.         local estimate_names "`estimate_names' `estname'"
 21.         local i = `i' + 1
 22.         est store `estname'
 23.     }
 24. }

