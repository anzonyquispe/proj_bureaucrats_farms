. foreach control_sample in $control_samples {
  2.     if !inlist("`control_sample'", "never", "both", "notyet") {
  3.         display as error "Unknown control sample: `control_sample'"
  4.         exit 198
  5.     }
  6.     use `analysis_base', clear
  7. 
.     local control_suffix "_controls_never"
  8.     if "`control_sample'" == "never" {
  9.         keep if treat == 1 | control_type == 1
 10.     }
 11.     else if "`control_sample'" == "both" {
 12.         local control_suffix "_controls_both"
 13.     }
 14.     else if "`control_sample'" == "notyet" {
 15.         keep if treat == 1 | control_type == 2
 16.         local control_suffix "_controls_notyet"
 17.     }
 18. 
.     display as text "Protest event study: controls=`control_sample', downup=$
> {downup_var}, N=" _N
 19. 
.     egen tag_ac = tag(ac_uq_id)
 20.     count if tag_ac == 1
 21.     local numacs = r(N)
 22. 
.     est clear
 23.     local i = 1
 24.     local estimate_names ""
 25.     foreach mod of local moderators_list {
 26.         replace moderator = `mod'
 27.         local rhs "ib`base'.relative_year_bin_aux##ib0.treat##ib0.`mod' wi
> nd_direction av_wind_speed"
 28.         local fcond `filter1'
 29. 
.         quietly summarize countk if treat == 1 & relative_year_bin <= -1 & `f
> cond'
 30.         local ymean = r(mean)
 31.         quietly summarize countk if treat == 1 & relative_year_bin <= -1 &
>  moderator == 1 & `fcond'
 32.         local ymean2 = r(mean)
 33. 
.         foreach fe of numlist $fe_list {
 34.             local fespec `fe`fe''
 35.             reghdfejl countk `rhs' if `fcond', ///
>                 absorb(`fespec') vce(cluster ac_elec_yr)
 36. 
.             estadd scalar ymean  = `ymean'
 37.             estadd scalar ymean2 = `ymean2'
 38.             estadd scalar acq    = `numacs'
 39.             estadd local smpl "Rural"
 40.             estadd local fespec "fe`fe'"
 41.             estadd local mod "`mod'"
 42.             estadd local controls "`control_sample'"
 43.             local estname evreg`i'
 44.             local i = `i' + 1
 45.             est store `estname'
 46.             local estimate_names "`estimate_names' `estname'"
 47.         }
 48.     }
 49. 
.     local outbase "${tables}/_app_17_5km_fe12_evst_all${sample}_rural${ster_s
> uffix}`control_suffix'"
 50.     estwrite evreg* using "`outbase'.ster", replace
 51.     estsave_csv `estimate_names' using "`outbase'.csv", replace
 52.     confirm file "`outbase'.ster"
 53.     confirm file "`outbase'.csv"
 54.     confirm file "`outbase'_scalars.csv"
 55.     display as result "Saved: `outbase'.ster and `outbase'.csv"
 56. }
