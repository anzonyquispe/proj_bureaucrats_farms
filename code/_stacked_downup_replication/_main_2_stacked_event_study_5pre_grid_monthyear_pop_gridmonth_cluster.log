. keep if year < 2022 | (year == 2022 & month <= 8)
(8,049,035 observations deleted)

. 
. capture confirm variable rice_prod_aclvl_ahigh

. if _rc {
.     merge m:1 unique_small_grid_id ac_uq_id using ///
>         "${int_data}/rice_moderators.dta", keep(master match) nogen ///
>         keepusing(rice_area_aclvl_ahigh rice_harvarea_aclvl_ahigh rice_prod_a
> clvl_ahigh)
. }

. 
. local dep_var countk

. local fe1 "unique_small_grid_id#cohort monthyear#cohort"

. local moderators_list moderator rice_prod_aclvl_ahigh

. * local moderators_list moderator downup_ac rice_area_aclvl_ahigh rice_harvar
> ea_aclvl_ahigh rice_prod_aclvl_ahigh
. gen moderator = 0

. egen tag_ac = tag(ac_uq_id)

. count if tag_ac == 1
  808

. local numacs = r(N)

. 
. est clear

. local i = 1

. local estimate_names ""

. foreach mod of local moderators_list {
  2.     replace moderator = `mod'
  3.     local rhs ///
>         "ib`base'.relative_year_bin_aux##ib0.treat##ib0.`mod' `weather_contro
> ls'"
  4. 
.     quietly summarize `dep_var' if treat == 1 & relative_year_bin <= -1
  5.     local ymean = r(mean)
  6.     quietly summarize `dep_var' if treat == 1 & relative_year_bin <= -1 & 
> moderator == 1
  7.     local ymean2 = r(mean)
  8. 
.     foreach fe of numlist $fe_list {
  9.         if `fe' != 1 {
 10.             display as error "This standalone file supports only FE specif
> ication 1."
 11.             exit 198
 12.         }
 13. 
.         reghdfejl `dep_var' `rhs', absorb(`fe`fe'') ///
>             cluster(`cluster_variables')
 14.         estadd scalar ymean = `ymean'
 15.         estadd scalar ymean2 = `ymean2'
 16.         estadd scalar acq = `numacs'
 17.         estadd local smpl "Rural"
 18.         estadd local fespec "Grid x cohort and month-year x cohort"
 19.         estadd local mod "`mod'"
 20.         estadd local monthyearfe "Y"
 21.         estadd local acfe "N"
 22.         estadd local acmonthfe "N"
 23.         estadd local gridfe "Y"
 24.         estadd local weathercontrols "`controls_tag'"
 25.         estadd local clusterspec "`cluster_tag'"
 26.         local estname evreg`i'
 27.         local i = `i' + 1
 28.         est store `estname'
 29.         local estimate_names "`estimate_names' `estname'"
 30.     }
 31. }
