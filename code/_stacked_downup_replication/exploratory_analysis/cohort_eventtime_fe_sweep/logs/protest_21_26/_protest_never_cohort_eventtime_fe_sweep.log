. 
. *****************************************************************************
> ***
. * DiD interactions on exactly the same -8,...,1 observations.
. *****************************************************************************
> ***
. gen byte post_ = relative_year_bin >= 0

. quietly summarize countk if treat == 1 & relative_year_bin <= -1 & downup_ac_
> pop == 1

. local ymean2 = r(mean)

. local rhs "ib0.post_##ib0.treat##ib0.downup_ac_pop wind_direction av_wind_spe
> ed"

. foreach selected_fe of numlist $fe_list {
  2.     local original_fespec "`fe`selected_fe''"
  3.     local fespec "`original_fespec' relative_year_bin_aux#cohort"
  4.     local tag : display %02.0f `selected_fe'
  5.     local tag = strtrim("`tag'")
  6.     display as result "PROTEST DID FE `selected_fe': `fespec'"
  7.     est clear
  8.     reghdfejl countk `rhs', absorb(`fespec') vce(cluster ac_elec_yr)
  9.     estadd scalar ymean = `ymean'
 10.     estadd scalar ymean2 = `ymean2'
 11.     estadd scalar acq = `numacs'
 12.     estadd scalar fe_id = `selected_fe'
 13.     estadd scalar n_treated = `n_treated'
 14.     estadd scalar n_control = `n_control'
 15.     estadd scalar n_cohorts = `number_cohorts'
 16.     estadd local smpl "Rural"
 17.     estadd local fespec "`fespec'"
 18.     estadd local mod "downup_ac_pop"
 19.     estadd local controls "never"
 20.     estadd local cohortvar "cohort"
 21.     est store evreg1
 22.     local out "${tables}/protest_never_cohorttime_fe`tag'_did_interaction_
> rural${ster_suffix}_all"
 23.     estwrite evreg1 using "`out'.ster", replace
 24.     confirm file "`out'.ster"
 25. }
