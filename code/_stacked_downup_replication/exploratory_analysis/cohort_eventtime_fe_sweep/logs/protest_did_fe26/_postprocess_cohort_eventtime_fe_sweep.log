. do /users/aquisper/proj_bureaucrats_farms/code/_stacked_downup_replication/ex
> ploratory_analysis/cohort_eventtime_fe_sweep/_postprocess_cohort_eventtime_fe
> _sweep.do protest 26 

. *****************************************************************************
> ***
. * Export CSVs and interaction plots from cohort-event-time FE sweep STER file
> s.
. * No analysis dataset is loaded. This runs only after all assigned regression
> s.
. *****************************************************************************
> ***
. version 17

. clear all

. set more off

. 
. args analysis_arg fe_arg

. if !inlist("`analysis_arg'", "politician", "protest") {
.     display as error "First argument must be politician or protest."
.     exit 198
. }

. if "`fe_arg'" == "" {
.     display as error "Second argument must be an FE numlist."
.     exit 198
. }

. foreach fe of numlist `fe_arg' {
  2.     if !inrange(`fe', 1, 32) exit 198
  3. }

. 
. global code "/users/aquisper/proj_bureaucrats_farms/code/_stacked_downup_repl
> ication"

. global tables "${code}/../../tables/exploratory_analysis/cohort_eventtime_fe_
> sweep"

. global figures "${code}/../../figures/exploratory_analysis/cohort_eventtime_f
> e_sweep"

. capture mkdir "${code}/../../figures/exploratory_analysis"

. capture mkdir "${figures}"

. 
. capture program drop estsave_csv

. quietly do "${code}/estsave_csv.ado"

. quietly do "${code}/interaction_graph.ado"

. 
. foreach fe of numlist `fe_arg' {
  2.     local tag : display %02.0f `fe'
  3.     local tag = strtrim("`tag'")
  4.     if "`analysis_arg'" == "politician" {
  5.         local prefix "politician_byprov_cohorttime_fe`tag'"
  6.         local graph_type "politician"
  7.     }
  8.     else {
  9.         local prefix "protest_never_cohorttime_fe`tag'"
 10.         local graph_type "protest"
 11.     }
 12. 
.     local event "${tables}/`prefix'_event_rural_acpop_all"
 13.     confirm file "`event'.ster"
 14.     est clear
 15.     estread using "`event'.ster"
 16.     quietly estimates dir
 17.     local names `r(names)'
 18.     estsave_csv `names' using "`event'.csv", replace
 19.     confirm file "`event'.csv"
 20.     confirm file "`event'_scalars.csv"
 21. 
.     local did "${tables}/`prefix'_did_interaction_rural_acpop_all"
 22.     confirm file "`did'.ster"
 23.     est clear
 24.     estread using "`did'.ster"
 25.     quietly estimates dir
 26.     local names `r(names)'
 27.     estsave_csv `names' using "`did'.csv", replace
 28.     confirm file "`did'.csv"
 29.     confirm file "`did'_scalars.csv"
 30. 
.     est clear
 31.     interaction_graph using "`did'.ster", estimates(1) ///
>         output("${figures}/`prefix'_did_interaction_rural_acpop_all") ///
>         type(`graph_type') modvar(downup_ac_pop)
 32.     confirm file "${figures}/`prefix'_did_interaction_rural_acpop_all_1.pn
> g"
 33. }

