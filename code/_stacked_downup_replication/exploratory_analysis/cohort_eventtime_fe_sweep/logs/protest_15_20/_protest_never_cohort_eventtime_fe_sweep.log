. global tables "${code}/../../tables/exploratory_analysis/cohort_eventtime_fe_
> sweep"

. capture mkdir "${code}/../../tables/exploratory_analysis"

. capture mkdir "${tables}"

. 
. local input_file "${int_data}/stacked_data_protest5km${sample}.csv"

. confirm file "`input_file'"

. display as text "Input: `input_file' | controls: never | FE list: $fe_list"
Input: /groups/sgulzar/sa_fires/proj_bureaucrats_farms/data_output/intermediate
> /stacked_data_protest5km.csv | controls: never | FE list: 15/20

. import delimited using "`input_file'", clear varnames(1)
