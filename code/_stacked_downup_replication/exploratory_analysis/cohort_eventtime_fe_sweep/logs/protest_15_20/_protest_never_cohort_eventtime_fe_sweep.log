. *****************************************************************************
> ***
. * Event studies.
. *****************************************************************************
> ***
. foreach mod of local moderators_list {
  2.     replace moderator = `mod'
  3.     local rhs "ib`base'.relative_year_bin_aux##ib0.treat##ib0.`mod' wind_d
> irection av_wind_speed"
  4.     foreach selected_fe of numlist $fe_list {
  5.         local original_fespec "`fe`selected_fe''"
  6.         local fespec "`original_fespec' relative_year_bin_aux#cohort"
  7.         local tag : display %02.0f `selected_fe'
  8.         local tag = strtrim("`tag'")
  9.         display as result "PROTEST EVENT FE `selected_fe': `fespec'"
 10.         est clear
 11.         reghdfejl countk `rhs', absorb(`fespec') vce(cluster ac_elec_yr)
 12.         estadd scalar ymean = `ymean'
 13.         estadd scalar ymean2 = `ymean2'
 14.         estadd scalar acq = `numacs'
 15.         estadd scalar fe_id = `selected_fe'
 16.         estadd scalar n_treated = `n_treated'
 17.         estadd scalar n_control = `n_control'
 18.         estadd scalar n_cohorts = `number_cohorts'
 19.         estadd local smpl "Rural"
 20.         estadd local fespec "`fespec'"
 21.         estadd local mod "`mod'"
 22.         estadd local controls "never"
 23.         estadd local cohortvar "cohort"
 24.         est store evreg1
 25.         local out "${tables}/protest_never_cohorttime_fe`tag'_event_rural$
> {ster_suffix}_all"
 26.         estwrite evreg1 using "`out'.ster", replace
 27.         confirm file "`out'.ster"
 28.     }
 29. }
