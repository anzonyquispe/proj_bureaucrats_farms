 16.     estadd local fespec "`fespec'"
 17.     estadd local mod "`mod'"
 18.     estadd local controls "unchanged full sample"
 19.     local estname evreg`i'
 20.     local estimate_names "`estimate_names' `estname'"
 21.     local i = `i' + 1
