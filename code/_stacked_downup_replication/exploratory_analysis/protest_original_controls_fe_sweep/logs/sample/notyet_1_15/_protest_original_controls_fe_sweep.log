. 
. * Reload the prepared full sample once and loop over the DiD specifications.
. use `full_analysis_sample', clear

. gen byte post_ = relative_year_bin >= 0

. gen byte moderator = downup_ac_pop

. local moderators_list downup_ac_pop

. count if treat == 1
  10,320

. local did_n_treated = r(N)

. count if treat == 0
  69,239

. local did_n_control = r(N)

. egen byte did_tag_ac = tag(ac_uq_id)

. count if did_tag_ac
  222

. local did_numacs = r(N)

. drop did_tag_ac

. quietly summarize countk if treat == 1 & relative_year_bin <= -1

. local did_ymean = r(mean)

. quietly summarize countk if treat == 1 & relative_year_bin <= -1 & moderator 
> == 1

. local did_ymean2 = r(mean)

. 
. foreach mod of local moderators_list {
  2.     local rhs "ib0.post_##ib0.treat##ib0.`mod' wind_direction av_wind_spee
> d"
  3.     foreach selected_fe of numlist $fe_list {
  4.         local fespec "`fe`selected_fe''"
  5.         local fe_tag : display %02.0f `selected_fe'
  6.         local fe_tag = strtrim("`fe_tag'")
  7.         local prefix "protest_original_fe`fe_tag'_controls_`control_sample
> '"
  8.         display as result "DID controls=`control_sample' FE=`selected_fe':
>  `fespec'"
  9.         est clear
 10.         reghdfejl countk `rhs', absorb(`fespec') vce(cluster ac_elec_yr)
 11.         estadd scalar ymean = `did_ymean'
 12.         estadd scalar ymean2 = `did_ymean2'
 13.         estadd scalar acq = `did_numacs'
 14.         estadd scalar fe_id = `selected_fe'
 15.         estadd scalar n_treated = `did_n_treated'
 16.         estadd scalar n_control = `did_n_control'
 17.         estadd local smpl "Rural"
 18.         estadd local fespec "`fespec'"
 19.         estadd local mod "`mod'"
 20.         estadd local controls "`control_sample'"
 21.         est store evreg1
 22.         local did_out "${tables}/`prefix'_did_interaction_rural_acpop_all"
 23.         estwrite evreg1 using "`did_out'.ster", replace
 24.         confirm file "`did_out'.ster"
 25.     }
 26. }
