. 
. foreach controls in never both notyet {
  2.     forvalues fe = 1/32 {
  3.         local tag : display %02.0f `fe'
  4.         local tag = strtrim("`tag'")
  5.         local prefix "protest_original_fe`tag'_controls_`controls'"
  6. 
.         local event "${tables}/`prefix'_event_rural_acpop_all"
  7.         confirm file "`event'.ster"
  8.         est clear
  9.         estread using "`event'.ster"
 10.         quietly estimates dir
 11.         local names `r(names)'
 12.         estsave_csv `names' using "`event'.csv", replace
 13.         confirm file "`event'_scalars.csv"
 14. 
.         local did "${tables}/`prefix'_did_interaction_rural_acpop_all"
 15.         confirm file "`did'.ster"
 16.         est clear
 17.         estread using "`did'.ster"
 18.         quietly estimates dir
 19.         local names `r(names)'
 20.         estsave_csv `names' using "`did'.csv", replace
 21.         confirm file "`did'_scalars.csv"
 22. 
.         est clear
 23.         interaction_graph using "`did'.ster", estimates(1) ///
>             output("${figures}/`prefix'_did_interaction_rural_acpop_all") ///
>             type(protest) modvar(downup_ac_pop)
 24.         confirm file "${figures}/`prefix'_did_interaction_rural_acpop_all_
> 1.png"
 25.     }
 26. }

