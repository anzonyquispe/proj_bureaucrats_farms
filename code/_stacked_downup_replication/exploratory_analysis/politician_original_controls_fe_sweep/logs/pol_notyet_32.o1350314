. *****************************************************************************
> ***
. * 1. Baseline event study.
. *****************************************************************************
> ***
. 
. use `full_analysis_sample', clear

. keep if inrange(relative_year_bin, -5, 4)
(1,383,389 observations deleted)

. quietly summarize relative_year_bin

. local rmin = r(min)

. local rmax = r(max)

. assert `rmin' == -5

. assert `rmax' == 4

. gen int relative_year_bin_aux = relative_year_bin - `rmin' + 1

. local base = -1 - `rmin' + 1

. gen byte moderator = 0

. * local moderators_list moderator downup_ac rice_area_aclvl_ahigh rice_harvar
> ea_aclvl_ahigh rice_prod_aclvl_ahigh
. local moderators_list moderator

. 
. count if treat == 1
  3,356,320

. local event_n_treated = r(N)

. count if treat == 0
  7,576,370

. local event_n_control = r(N)

. egen byte event_tag_ac = tag(ac_uq_id)

. count if event_tag_ac == 1
  472

. local event_numacs = r(N)

. drop event_tag_ac

. 
. quietly summarize countk if treat == 1 & relative_year_bin <= -1

. local event_ymean = r(mean)

. quietly summarize countk if treat == 1 & relative_year_bin <= -1 & moderator 
> == 1

. local event_ymean2 = r(mean)

. 
. est clear

. local event_i = 1

. foreach mod of local moderators_list {
  2.     replace moderator = `mod'
  3.     local event_rhs "ib`base'.relative_year_bin_aux##ib0.treat##ib0.`mod' 
> wind_direction av_wind_speed"
  4. 
.     reghdfejl countk `event_rhs', absorb(`fespec') vce(cluster ac_elec_yr)
  5.     estadd scalar ymean = `event_ymean'
  6.     estadd scalar ymean2 = `event_ymean2'
  7.     estadd scalar acq = `event_numacs'
  8.     estadd scalar fe_id = `selected_fe'
  9.     estadd scalar n_treated = `event_n_treated'
 10.     estadd scalar n_control = `event_n_control'
 11.     estadd local smpl "Rural"
 12.     estadd local fespec "`fespec'"
 13.     estadd local mod "`mod'"
 14.     estadd local controls "`control_sample'"
 15.     est store evreg`event_i'
 16.     local event_i = `event_i' + 1
 17. }
