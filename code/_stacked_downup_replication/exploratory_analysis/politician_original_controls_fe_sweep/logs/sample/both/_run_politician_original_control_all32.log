. *****************************************************************************
> ***
. * Event-study loop: prepare once, estimate FE 1/32, save each independently.
. *****************************************************************************
> ***
. use `full_analysis_sample', clear

. keep if inrange(relative_year_bin, -5, 4)
(25,900 observations deleted)

. quietly summarize relative_year_bin

. assert r(min) == -5

. assert r(max) == 4

. gen int relative_year_bin_aux = relative_year_bin + 6

. local base = 5

. gen byte moderator = 0

. * local moderators_list moderator downup_ac rice_area_aclvl_ahigh rice_harvar
> ea_aclvl_ahigh rice_prod_aclvl_ahigh
. local moderators_list moderator

. 
. count if treat == 1
  37,910

. local event_n_treated = r(N)

. count if treat == 0
  95,019

. local event_n_control = r(N)

. egen byte event_tag_ac = tag(ac_uq_id)

. count if event_tag_ac
  483

. local event_numacs = r(N)

. drop event_tag_ac

. quietly summarize countk if treat == 1 & relative_year_bin <= -1

. local event_ymean = r(mean)

. quietly summarize countk if treat == 1 & relative_year_bin <= -1 & moderator 
> == 1

. local event_ymean2 = r(mean)

. 
. foreach mod of local moderators_list {
  2.     replace moderator = `mod'
  3.     local event_rhs "ib`base'.relative_year_bin_aux##ib0.treat##ib0.`mod' 
> wind_direction av_wind_speed"
  4.     foreach fe of numlist $fe_list {
  5.         local fespec "`fe`fe''"
  6.         local tag : display %02.0f `fe'
  7.         local tag = strtrim("`tag'")
  8.         local prefix "politician_original_fe`tag'_controls_`control_sample
> '"
  9.         display as result "EVENT controls=`control_sample' FE=`fe'/32: `fe
> spec'"
 10.         est clear
 11.         reghdfejl countk `event_rhs', absorb(`fespec') vce(cluster ac_elec
> _yr)
 12.         estadd scalar ymean = `event_ymean'
 13.         estadd scalar ymean2 = `event_ymean2'
 14.         estadd scalar acq = `event_numacs'
 15.         estadd scalar fe_id = `fe'
 16.         estadd scalar n_treated = `event_n_treated'
 17.         estadd scalar n_control = `event_n_control'
 18.         estadd local smpl "Rural"
 19.         estadd local fespec "`fespec'"
 20.         estadd local mod "`mod'"
 21.         estadd local controls "`control_sample'"
 22.         est store evreg1
 23.         local out "${tables}/`prefix'_event_rural_acpop_all"
 24.         estwrite evreg1 using "`out'.ster", replace
 25.         confirm file "`out'.ster"
 26.     }
 27. }
