. count if _merge == 1
  0

. display as text "Rows without rural classification: " r(N)
Rows without rural classification: 0

. drop _merge

. keep if ${is_rural_var} == 1
(11,013,790 observations deleted)

. keep if year < 2022 | (year == 2022 & month <= 8)
(5,521,118 observations deleted)

. 
. if "`control_sample'" == "never" {
.     keep if treat == 1 | control_type == 1
. }

. else if "`control_sample'" == "notyet" {
.     keep if treat == 1 | control_type == 2
.     display as error "CAUTION: control_type 2 is the legacy partial-zero-spel
> l group."
. }

. 
