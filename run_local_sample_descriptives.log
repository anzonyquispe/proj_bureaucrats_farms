. foreach v of local colsel {
  2.     local meanfmt ""
  3.     local sdfmt ""
  4.     local minfmt ""
  5.     local maxfmt ""
  6.     local Nfmt ""
  7.     local ufmt ""
  8.     if strpos(" `uniquevars' ", " `v' ") {
  9.         quietly _unique_count `v'
 10.         _fmt_int `r(n)'
 11.         local ufmt "`r(out)'"
 12.     }
 13.     else {
 14.         quietly summarize `v'
 15.         _fmt_num `r(mean)'
 16.         local meanfmt "`r(out)'"
 17.         _fmt_num `r(sd)'
 18.         local sdfmt "`r(out)'"
 19.         _fmt_num `r(min)'
 20.         local minfmt "`r(out)'"
 21.         _fmt_num `r(max)'
 22.         local maxfmt "`r(out)'"
 23.         quietly count if !missing(`v')
 24.         _fmt_int `r(N)'
 25.         local Nfmt "`r(out)'"
 26.     }
 27.     local vlabel "`lab_`v''"
 28.     file write texout "`vlabel' & `meanfmt' & `sdfmt' & `minfmt' & `maxfmt
> ' & `Nfmt' & `ufmt'\\\\" _n
 29. }

. 
. file write texout "\bottomrule" _n

. file write texout "\end{tabular}" _n

