. do _tweets_replot_from_ster.do 

. // _tweets_replot_from_ster.do
. // Walk every .ster file in `sters_dir`, read the did_multiplegt_dyn point
. // estimates and standard errors directly from e() scalars, and produce a
. // connected-scatter event-study plot per file with 95% CIs. Omitted
. // reference at x=0 (beta=0, no CI).
. //
. // Convention (did_multiplegt_dyn stores everything as e() scalars):
. //   point: e(Effect_k), e(Placebo_k)        — k post / k pre
. //   SE   : e(se_effect_k), e(se_placebo_k)  — same k
. //   x    : Effect_k -> +k    Placebo_k -> -k    (omitted -> 0)
. //   CI   : beta ± 1.96 * se   (95% normal)
. 
. clear all

. set more off

. 
. local sters_dir "/Users/anzony.quisperojas/Library/CloudStorage/Dropbox/sa_fires/proj_bureaucrats_farms/tex/pap
> er/figures/tmp_figs"

. 
. display as text "Replotting from ster files in: `sters_dir'"
Replotting from ster files in: /Users/anzony.quisperojas/Library/CloudStorage/Dropbox/sa_fires/proj_bureaucrats_f
> arms/tex/paper/figures/tmp_figs

. 
. local files : dir "`sters_dir'" files "*.ster"

. local nfiles : word count `files'

. if `nfiles' == 0 {
.     display as error "No .ster files found in `sters_dir'"
.     exit 1
. }

. display as text "Found `nfiles' ster files."
Found 209 ster files.

. 
. local n_ok   = 0

. local n_fail = 0

. 
. foreach f of local files {
  2.     local stem = subinstr("`f'", ".ster", "", .)
  3.     display as text _newline ">>> `stem'"
  4. 
.     capture estimates use "`sters_dir'/`f'"
  5.     if _rc != 0 {
  6.         display as error "[fail] cannot load `f' (rc=`=_rc')"
  7.         local n_fail = `n_fail' + 1
  8.         continue
  9.     }
 10. 
.     tempfile post_tmp
 11.     capture postclose ph_tmp
 12.     postfile ph_tmp double(x beta se) using "`post_tmp'", replace
 13. 
.     local found = 0
 14.     // Placebos: k = 1..5 -> x = -k
.     forvalues k = 1/5 {
 15.         local beta_val = e(Placebo_`k')
 16.         local se_val   = e(se_placebo_`k')
 17.         if !missing(`beta_val') & !missing(`se_val') {
 18.             post ph_tmp (-`k') (`beta_val') (`se_val')
 19.             local found = `found' + 1
 20.         }
 21.     }
 22.     // Effects: k = 1..5 -> x = +k
.     forvalues k = 1/5 {
 23.         local beta_val = e(Effect_`k')
 24.         local se_val   = e(se_effect_`k')
 25.         if !missing(`beta_val') & !missing(`se_val') {
 26.             post ph_tmp (`k') (`beta_val') (`se_val')
 27.             local found = `found' + 1
 28.         }
 29.     }
 30.     // Omitted reference period at x = 0 (no CI).
.     post ph_tmp (0) (0) (0)
 31.     postclose ph_tmp
 32. 
.     if `found' == 0 {
 33.         display as error "[fail] no e(Effect_*) or e(Placebo_*) scalars in `f'"
 34.         local n_fail = `n_fail' + 1
 35.         continue
 36.     }
 37. 
.     use "`post_tmp'", clear
 38.     sort x
 39.     gen ci_lo = beta - 1.96 * se
 40.     gen ci_hi = beta + 1.96 * se
 41. 
.     twoway (rcap ci_hi ci_lo x, lc(navy) lwidth(medthin)) ///
>            (connected beta x, ms(O) mc(navy) lc(navy) msize(small)), ///
>         xline(0, lp(dash) lc(gray)) yline(0, lp(solid) lc(red)) ///
>         xtitle("Time relative to switch") ///
>         ytitle("Effect on tweets") ///
>         xlabel(-5(1)5) ///
>         legend(off) ///
>         title("`stem'", size(small)) ///
>         graphregion(color(white))
 42. 
.     capture graph export "`sters_dir'/`stem'.png", replace width(1200)
 43.     if _rc != 0 {
 44.         display as error "[fail] graph export failed for `stem' (rc=`=_rc')"
 45.         local n_fail = `n_fail' + 1
 46.     }
 47.     else {
 48.         local n_ok = `n_ok' + 1
 49.     }
 50. 
.     estimates clear
 51.     clear
 52. }

