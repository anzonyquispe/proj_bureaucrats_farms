. do _tweets_replot_r2_r3.do 

. // _tweets_replot_r2_r3.do
. // Walk every r2_*.ster and r3_*.ster file in ${shell}/tex/paper/figures/, read
. // did_multiplegt_dyn estimates directly from e() scalars, and produce TWO
. // connected-scatter event-study plots per ster:
. //   <stem>.png         original estimates with 95% CIs
. //   <stem>_rotated.png same outcome with a linear pre-trend (fit on x<0
. //                       via OLS no-constant) extrapolated across all periods
. //                       and subtracted from each estimate -- mirrors the
. //                       agregation_result() rotation used in
. //                       code/_replication_rural/tools/plot_event_studies.R.
. //
. // Convention:
. //   e(Placebo_k) / e(se_placebo_k)  -> x = -k     (k = 1..5)
. //   e(Effect_k)  / e(se_effect_k)   -> x = +k     (k = 1..5)
. //   omitted reference at x = 0 (beta=0, no CI)
. //   CI = beta +/- 1.96 * se
. 
. clear all

. set more off

. 
. local sters_dir "/Users/anzony.quisperojas/Library/CloudStorage/Dropbox/sa_fires
> /proj_bureaucrats_farms/tex/paper/figures"

. 
. display as text "Replotting r2_*/r3_* ster files in: `sters_dir'"
Replotting r2_*/r3_* ster files in: /Users/anzony.quisperojas/Library/CloudStorage
> /Dropbox/sa_fires/proj_bureaucrats_farms/tex/paper/figures

. 
. local n_ok   = 0

. local n_fail = 0

. 
. foreach pat in "r2_*.ster" "r3_*.ster" {
  2.     local files : dir "`sters_dir'" files "`pat'"
  3.     local nfiles : word count `files'
  4.     display as text _newline "=== Pattern `pat' : `nfiles' files ==="
  5. 
.     foreach f of local files {
  6.         local stem = subinstr("`f'", ".ster", "", .)
  7.         display as text _newline ">>> `stem'"
  8. 
.         capture estimates use "`sters_dir'/`f'"
  9.         if _rc != 0 {
 10.             display as error "[fail] cannot load `f' (rc=`=_rc')"
 11.             local n_fail = `n_fail' + 1
 12.             continue
 13.         }
 14. 
.         tempfile post_tmp
 15.         capture postclose ph_tmp
 16.         postfile ph_tmp double(x beta se) using "`post_tmp'", replace
 17. 
.         local found = 0
 18.         forvalues k = 1/5 {
 19.             local beta_val = e(Placebo_`k')
 20.             local se_val   = e(se_placebo_`k')
 21.             if !missing(`beta_val') & !missing(`se_val') {
 22.                 post ph_tmp (-`k') (`beta_val') (`se_val')
 23.                 local found = `found' + 1
 24.             }
 25.         }
 26.         forvalues k = 1/5 {
 27.             local beta_val = e(Effect_`k')
 28.             local se_val   = e(se_effect_`k')
 29.             if !missing(`beta_val') & !missing(`se_val') {
 30.                 post ph_tmp (`k') (`beta_val') (`se_val')
 31.                 local found = `found' + 1
 32.             }
 33.         }
 34.         post ph_tmp (0) (0) (0)
 35.         postclose ph_tmp
 36. 
.         if `found' == 0 {
 37.             display as error "[fail] no e(Effect_*) / e(Placebo_*) in `f'"
 38.             local n_fail = `n_fail' + 1
 39.             continue
 40.         }
 41. 
.         use "`post_tmp'", clear
 42.         sort x
 43.         gen ci_lo = beta - 1.96 * se
 44.         gen ci_hi = beta + 1.96 * se
 45. 
.         // -------------------------------------------------------------------
.         // 1) Original event study
.         // -------------------------------------------------------------------
.         twoway (rcap ci_hi ci_lo x, lc(navy) lwidth(medthin)) ///
>                (connected beta x, ms(O) mc(navy) lc(navy) msize(small)), ///
>             xline(0, lp(dash) lc(gray)) yline(0, lp(solid) lc(red)) ///
>             xtitle("Time relative to switch") ///
>             ytitle("Effect on tweets") ///
>             xlabel(-5(1)5) ///
>             legend(off) ///
>             title("`stem'", size(small)) ///
>             graphregion(color(white))
 46. 
.         capture graph export "`sters_dir'/`stem'.png", replace width(1200)
 47.         if _rc != 0 {
 48.             display as error "[fail] graph export failed for `stem'"
 49.             local n_fail = `n_fail' + 1
 50.             continue
 51.         }
 52. 
.         // -------------------------------------------------------------------
.         // 2) Rotated event study: fit linear pre-trend through omitted period
.         //    (x=0, beta=0) via OLS without constant on x<0, then subtract.
.         // -------------------------------------------------------------------
.         capture quietly regress beta x if x < 0, noconstant
 53.         if _rc != 0 | missing(_b[x]) {
 54.             // Pre-trend not estimable (e.g. all betas zero); skip rotation.
.             display as text "  -- pre-trend not estimable; skipping rotated plot
> "
 55.             local n_ok = `n_ok' + 1
 56.             estimates clear
 57.             clear
 58.             continue
 59.         }
 60.         scalar slope = _b[x]
 61.         gen trend       = slope * x
 62.         gen res_b       = beta - trend
 63.         gen rot_ci_lo   = res_b - 1.96 * se
 64.         gen rot_ci_hi   = res_b + 1.96 * se
 65.         // Omitted period (x=0): keep at zero (residual = 0 - 0 = 0).
.         replace res_b     = 0 if x == 0
 66.         replace rot_ci_lo = 0 if x == 0
 67.         replace rot_ci_hi = 0 if x == 0
 68. 
.         twoway (rcap rot_ci_hi rot_ci_lo x, lc(maroon) lwidth(medthin)) ///
>                (connected res_b x, ms(O) mc(maroon) lc(maroon) msize(small)), //
> /
>             xline(0, lp(dash) lc(gray)) yline(0, lp(solid) lc(red)) ///
>             xtitle("Time relative to switch") ///
>             ytitle("Effect on tweets (rotated)") ///
>             xlabel(-5(1)5) ///
>             legend(off) ///
>             title("`stem' (rotated)", size(small)) ///
>             graphregion(color(white))
 69. 
.         capture graph export "`sters_dir'/`stem'_rotated.png", replace width(120
> 0)
 70.         if _rc != 0 {
 71.             display as error "[fail] rotated graph export failed for `stem'"
 72.             local n_fail = `n_fail' + 1
 73.         }
 74.         else {
 75.             local n_ok = `n_ok' + 1
 76.         }
 77. 
.         scalar drop _all
 78.         estimates clear
 79.         clear
 80.     }
 81. }

